{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poziom obozu",
  "description": "Poziom samego obozu: od startLevel do maxLevel, za samo złoto, a każdy poziom ponad pierwszy przyspiesza budowy budynków.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "startLevel", "maxLevel", "effect", "costs", "minutes", "evolution", "cornerstone", "collector", "queue"],
  "properties": {
    "$comment": { "type": "string" },
    "id": { "const": "camp" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "startLevel": { "type": "integer", "minimum": 1 },
    "maxLevel": { "type": "integer", "minimum": 2 },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "perLevel", "unit", "text", "startText"],
      "properties": {
        "kind": { "const": "buildSpeed" },
        "perLevel": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "const": "percent" },
        "text": { "type": "string", "pattern": "\\{value\\}", "description": "Skutek od drugiego poziomu; {value}: o ile szybsze są budowy." },
        "startText": { "type": "string", "minLength": 1, "description": "Skutek na poziomie startowym, bez przyspieszenia." }
      }
    },
    "costs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "description": "Samo złoto: inne zasoby nie są potrzebne.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "base", "growth", "fromLevel"],
        "properties": {
          "resource": { "const": "gold" },
          "base": { "type": "number", "exclusiveMinimum": 0 },
          "growth": { "type": "number", "minimum": 1 },
          "fromLevel": { "type": "integer", "minimum": 2 }
        }
      }
    },
    "minutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels"],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number", "minimum": 1 },
          "description": "Minuty rozwoju do poziomu 1, 2, … aż do maxLevel; poziom startowy obóz ma od razu."
        }
      }
    },
    "evolution": { "type": "string", "minLength": 1, "description": "Zapowiedź ewolucji po najwyższym poziomie." },
    "cornerstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "text", "buildings", "camp", "ready"],
      "description": "Kamień węgielny Warowni na planszy z Osadą: jego nazwa, podpis na planszy, opis, nazwy dwóch rzędów postępu i zdanie, gdy wszystko jest gotowe; spirit: duch budowniczego, który skupuje przy nim zasoby obozu.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "buildings": { "type": "string", "minLength": 1 },
        "camp": { "type": "string", "minLength": 1 },
        "ready": { "type": "string", "minLength": 1 },
        "spirit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["art", "name", "line", "lot", "gold", "texts"],
          "description": "Duch budowniczego: popiersie (art, plik w src/client/art/residents), imię, jedna kwestia i skup zasobów obozu: gold złota za lot sztuk każdego zasobu, w dół do pełnej monety.",
          "properties": {
            "art": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "name": { "type": "string", "minLength": 1 },
            "line": { "type": "string", "minLength": 1 },
            "lot": { "type": "integer", "minimum": 1, "description": "Ile sztuk kosztuje cena z gold." },
            "gold": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "integer", "minimum": 1 },
              "description": "Złoto za lot sztuk, po id zasobu z resources.json."
            },
            "texts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["price", "need", "least", "sold", "unknown", "amount", "notEnough", "locked"],
              "properties": {
                "price": { "type": "string", "pattern": "\\{gold\\}.*\\{lot\\}", "description": "Cena przy zasobie; {gold}: złoto, {lot}: za ile sztuk." },
                "need": { "type": "string", "pattern": "\\{count\\}", "description": "Ile sztuk zasobu potrzeba jeszcze na budowy obozu." },
                "least": { "type": "string", "pattern": "\\{count\\}", "description": "Najmniej sztuk, za które duch płaci 1 zł; także odmowa serwera." },
                "sold": { "type": "string", "pattern": "\\{gold\\}", "description": "Komunikat po sprzedaży." },
                "unknown": { "type": "string", "minLength": 1 },
                "amount": { "type": "string", "minLength": 1 },
                "notEnough": { "type": "string", "minLength": 1 },
                "locked": { "type": "string", "minLength": 1, "description": "Odmowa bez Osady: bez niej kamienia nie ma." }
              }
            }
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["art", "name", "price", "everySeconds", "texts"],
      "description": "Zbieracz Systemu: duch tuż obok Skrzyni Konta na planszy, bez podpisu (art, ikona 32 × 32 w src/client/art/camp), kupowany raz na zawsze za price złota. Potem znika z planszy, a gra sama zbiera na bieżąco magazyny budynków produkcyjnych.",
      "properties": {
        "art": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": "integer", "minimum": 1, "description": "Cena w złocie, płatna raz." },
        "everySeconds": { "type": "integer", "minimum": 1, "description": "Co ile sekund najwyżej Zbieracz zbiera jeden magazyn (pełne zapełnienie zbiera od razu)." },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offer", "bought", "hint", "owned", "noGold"],
          "properties": {
            "offer": { "type": "string", "minLength": 1, "description": "Jedno zdanie w okienku zakupu: co robi Zbieracz." },
            "bought": { "type": "string", "minLength": 1, "description": "Komunikat po zakupie." },
            "hint": { "type": "string", "minLength": 1, "description": "Zdanie na ekranie budynku produkcyjnego, gdy postać ma Zbieracza." },
            "owned": { "type": "string", "minLength": 1, "description": "Odmowa serwera: Zbieracz jest już kupiony." },
            "noGold": { "type": "string", "minLength": 1, "description": "Odmowa serwera: za mało złota." }
          }
        }
      }
    },
    "fortress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "maxLevel", "costs", "minutes", "start", "building", "done"],
      "description": "Przemiana Obozu w Warownię (419 A, 430 A): budowa w miejscu budowy obozu, gdy Obóz i każdy jego budynek mają najwyższy poziom. Po niej stoją budynki Warowni (buildings.json: fortress).",
      "properties": {
        "id": { "const": "fortress" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "maxLevel": { "const": 1 },
        "costs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource", "base", "growth"],
            "properties": {
              "resource": { "type": "string", "minLength": 1 },
              "base": { "type": "number", "exclusiveMinimum": 0 },
              "growth": { "const": 1 }
            }
          }
        },
        "minutes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["levels"],
          "properties": { "levels": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "number", "minimum": 1 } } }
        },
        "start": { "type": "string", "minLength": 1, "description": "Przycisk przemiany." },
        "building": { "type": "string", "minLength": 1, "description": "Zdanie w czasie przemiany." },
        "done": { "type": "string", "minLength": 1, "description": "Zdanie po przemianie." }
      }
    },
    "queue": { "type": "integer", "minimum": 1, "maximum": 10, "description": "Ile budów obóz ma naraz, razem z trwającą; reszta czeka w kolejce." }
  }
}
