{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regiony",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "land",
      "name",
      "minLevel",
      "maxLevel",
      "safe",
      "description",
      "trait",
      "elite",
      "resources",
      "areas"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "land": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "minLevel": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "maxLevel": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "safe": {
        "type": "boolean"
      },
      "fightBoard": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Tło planszy walk wypraw w tej krainie (src/client/art/boards), pod szykiem w powtórce walki w raporcie, jak piasek Areny (790 B)."
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "trait": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "recoveryBonus": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.2
          },
          "frontArmorBonus": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.2
          },
          "backDodgeBonus": {
            "type": "number",
            "description": "O tyle więcej uniku dla postaci z tyłu szyku.",
            "minimum": 0,
            "maximum": 0.2
          },
          "effectTicks": {
            "type": "object",
            "description": "O ile ruchów dłużej trwa efekt (effects.json), u stworów i u postaci.",
            "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "healBonus": {
            "type": "number",
            "description": "O taką część więcej HP przywraca postaciom leczenie: umiejętności i mikstury (Borowina).",
            "minimum": 0,
            "maximum": 0.2
          }
        }
      },
      "elite": {
        "type": "string"
      },
      "resources": {
        "type": "object",
        "description": "Wagi zasobów (resources.json) w znaleziskach: im większa, tym częściej ten zasób.",
        "minProperties": 1,
        "additionalProperties": { "type": "number", "minimum": 0 }
      },
      "areas": {
        "type": "array",
        "description": "Regiony wewnętrzne: po kolei, bez przerw, każdy z własnym zakresem poziomów i spotkaniami. Cecha i bezpieczeństwo pochodzą z regionu, a elita też, chyba że region wewnętrzny ma własną.",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "minLevel",
            "maxLevel",
            "description",
            "encounters"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "minLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "maxLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "elite": {
              "type": "string",
              "description": "Elita tego regionu wewnętrznego zamiast elity regionu."
            },
            "champion": {
              "type": "string",
              "description": "Czempion regionu: najsilniejszy stwór (monsters.json, champion: true), spotykany tylko tutaj. W Wiatrołomach i Uroczysku stoi w ostatnim regionie wewnętrznym."
            },
            "encounters": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "weight",
                  "monsters"
                ],
                "properties": {
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "monsters": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  },
                  "minLevel": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Poziom postaci, od którego spotkanie się pojawia."
                  }
                }
              }
            },
            "tough": {
              "type": "array",
              "description": "Wymagające spotkania: trudniejsze, z lepszym łupem. Im dłuższa wyprawa, tym częściej się zdarzają.",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "weight",
                  "monsters"
                ],
                "properties": {
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "monsters": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  },
                  "levelBonus": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "O ile poziomów wyżej niż zwykle; domyślnie toughLevelBonus z balance.json."
                  },
                  "minLevel": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Poziom postaci, od którego spotkanie się pojawia."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
