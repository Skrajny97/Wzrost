{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Szczodre Gody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calendar",
    "camp",
    "decorations",
    "texts",
    "quests"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "calendar": {
      "description": "Kalendarz: od dnia first do dnia last miesiąca month jedna nagroda dziennie, days od first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "first",
        "last",
        "goldRound",
        "days",
        "sale"
      ],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "first": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "last": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "goldRound": {
          "type": "integer",
          "minimum": 1
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "goldMinutes": {
                "type": "integer",
                "minimum": 1
              },
              "timePoints": {
                "type": "integer",
                "minimum": 1
              },
              "systemPoints": {
                "type": "integer",
                "minimum": 1
              },
              "packs": {
                "type": "integer",
                "minimum": 1
              },
              "potion": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "scroll": {
                "enum": [
                  "ward-scroll",
                  "steady-scroll"
                ]
              },
              "decoration": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "cosmetics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              }
            },
            "dependencies": {
              "count": [
                "potion"
              ],
              "potion": [
                "count"
              ]
            }
          }
        },
        "sale": {
          "description": "Zimowy zestaw za Punkty Systemu w oknie kalendarza od dnia fromDay do ostatniego dnia kalendarza (autor 18.11.2026): prices, cena każdego przedmiotu zestawu (id z data/cosmetics.json).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromDay",
            "prices"
          ],
          "properties": {
            "fromDay": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "prices": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "snow": {
      "description": "Gęstość śniegu padającego nad całą grą w dniach zimowego Obozu (src/client/snowfall.js, 1065): light albo heavy. Bez niej śnieg nie pada.",
      "enum": [
        "light",
        "heavy"
      ]
    },
    "camp": {
      "description": "Zimowy Obóz: od dnia first do dnia last miesiąca month.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "first",
        "last"
      ],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "first": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "last": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      }
    },
    "decorations": {
      "description": "Ozdoby Obozu z kalendarza: nazwa i obrazek w src/client/art/winter (bez .png).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "art"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "art": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "lead",
        "days",
        "dayName",
        "take",
        "taken",
        "done",
        "missed",
        "decoration",
        "set",
        "scroll",
        "decorationGot",
        "setGot",
        "closed",
        "alreadyTaken",
        "bagFull",
        "changed",
        "tabWaiting",
        "tabTaken",
        "questsTab",
        "questFir",
        "questFirHint",
        "questCarp",
        "questFish",
        "questDish",
        "questLocked",
        "questsChest",
        "questsNote",
        "setOnlyFull",
        "sale",
        "saleLead",
        "saleSoon",
        "buy",
        "owned",
        "bought",
        "saleClosed",
        "saleOwned",
        "saleUnknown",
        "salePoints"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "days": {
          "type": "string"
        },
        "dayName": {
          "type": "string",
          "pattern": "\\{day\\}"
        },
        "take": {
          "type": "string",
          "pattern": "\\{day\\}"
        },
        "taken": {
          "type": "string"
        },
        "done": {
          "type": "string"
        },
        "missed": {
          "type": "string"
        },
        "decoration": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "scroll": {
          "type": "string"
        },
        "decorationGot": {
          "type": "string",
          "pattern": "\\{name\\}"
        },
        "setGot": {
          "type": "string"
        },
        "closed": {
          "type": "string"
        },
        "alreadyTaken": {
          "type": "string"
        },
        "bagFull": {
          "type": "string"
        },
        "changed": {
          "type": "string"
        },
        "tabWaiting": {
          "type": "string",
          "pattern": "\\{day\\}"
        },
        "tabTaken": {
          "type": "string",
          "pattern": "\\{day\\}"
        },
        "questsTab": {
          "type": "string"
        },
        "questFir": {
          "type": "string",
          "pattern": "\\{count\\}"
        },
        "questFirHint": {
          "type": "string",
          "pattern": "\\{minutes\\}"
        },
        "questCarp": {
          "type": "string"
        },
        "questFish": {
          "type": "string"
        },
        "questDish": {
          "type": "string"
        },
        "questLocked": {
          "type": "string",
          "pattern": "\\{level\\}"
        },
        "questsChest": {
          "type": "string"
        },
        "questsNote": {
          "type": "string"
        },
        "setOnlyFull": {
          "type": "string"
        },
        "sale": {
          "type": "string"
        },
        "saleLead": {
          "type": "string"
        },
        "saleSoon": {
          "type": "string"
        },
        "buy": {
          "type": "string"
        },
        "owned": {
          "type": "string"
        },
        "bought": {
          "type": "string",
          "pattern": "\\{name\\}"
        },
        "saleClosed": {
          "type": "string"
        },
        "saleOwned": {
          "type": "string"
        },
        "saleUnknown": {
          "type": "string"
        },
        "salePoints": {
          "type": "string",
          "pattern": "\\{price\\}"
        }
      }
    },
    "quests": {
      "description": "Zimowe zadania (1044.4): trzy na dzień zimowego Obozu i skrzynia za wszystkie.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list",
        "chest"
      ],
      "properties": {
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "count",
              "timePoints",
              "goldMinutes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "kind": {
                "enum": [
                  "explore",
                  "fish",
                  "cook"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "minutesPerPiece": {
                "type": "integer",
                "minimum": 1
              },
              "fish": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "timePoints": {
                "type": "integer",
                "minimum": 0
              },
              "goldMinutes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "explore"
                    }
                  }
                },
                "then": {
                  "required": [
                    "minutesPerPiece"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "fish"
                    }
                  }
                },
                "then": {
                  "required": [
                    "fish"
                  ]
                }
              }
            ]
          }
        },
        "chest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packs"
          ],
          "properties": {
            "packs": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "andrzejki": {
      "type": "object",
      "description": "Andrzejki: Wieczór wróżb (1082 C, 1083 C, 1084 A i B; src/engine/andrzejki.js).",
      "additionalProperties": false,
      "required": [
        "month",
        "days",
        "hours",
        "value",
        "goldRound",
        "cups",
        "omens",
        "background",
        "feat",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Miesiąc wieczorów wróżb."
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "description": "Wieczory wróżb: dzień miesiąca, godzina otwarcia (czas polski) i rodzaj wróżby.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day",
              "from",
              "kind"
            ],
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "from": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23
              },
              "kind": {
                "enum": [
                  "wax",
                  "cups"
                ]
              }
            }
          }
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "description": "Ile godzin trwa premia wróżby."
        },
        "value": {
          "type": "integer",
          "minimum": 1,
          "description": "O ile procent wróżba podnosi swój rodzaj premii."
        },
        "goldRound": {
          "type": "integer",
          "minimum": 1,
          "description": "Do ilu złotych zaokrągla się złoto nagrody."
        },
        "cups": {
          "type": "integer",
          "minimum": 2,
          "description": "Ile kubków stoi na stole."
        },
        "omens": {
          "type": "array",
          "minItems": 1,
          "description": "Wróżby: kształt wosku albo figurka spod kubka, rodzaj premii z weeks.json (kinds) i nagroda od razu.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "reward"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "xp",
                  "gold",
                  "items",
                  "materials",
                  "profession-xp",
                  "herbs",
                  "rest",
                  "reputation"
                ]
              },
              "reward": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "timePoints": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Punkty Czasu od razu."
                  },
                  "goldMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Złoto z tylu minut wyprawy na poziomie postaci."
                  },
                  "packs": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Pakiety kart Talii Systemu."
                  }
                }
              }
            }
          }
        },
        "background": {
          "type": "string",
          "description": "Tło portretu (id z cosmetics.json) za wróżby w oba wieczory."
        },
        "feat": {
          "type": "string",
          "description": "Licznik w feats postaci, z którego liczy się osiągnięcie (achievements.json)."
        },
        "texts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
