{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wprowadzenie narratora",
  "description": "Karty narratora dla nowej postaci i podpowiedzi przy podświetleniach. Kod pokazuje kartę i podświetlenie według id, więc każda z siedmiu kart i każda podpowiedź musi być dokładnie raz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skipLabel",
    "nextLabel",
    "cards",
    "hints"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "skipLabel": {
      "type": "string",
      "minLength": 1
    },
    "nextLabel": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "enum": [
              "intro",
              "time",
              "skip",
              "report",
              "character",
              "camp",
              "ending"
            ]
          },
          "text": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "voice": {
            "type": "string",
            "pattern": "^audio/narration/[a-z0-9-]+\\.mp3$",
            "description": "Nagranie głosu narratora, gdy już jest."
          }
        }
      }
    },
    "hints": {
      "type": "object",
      "description": "Krótkie zdanie przy podświetlonym miejscu, które gracz ma stuknąć.",
      "additionalProperties": false,
      "required": [
        "region",
        "area",
        "start",
        "skip",
        "claim",
        "character",
        "stats",
        "points",
        "camp",
        "plot",
        "build"
      ],
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "skip": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "character": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "stats": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "points": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "camp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "plot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    }
  }
}
