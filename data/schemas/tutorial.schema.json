{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wprowadzenie narratora",
  "description": "Kwestie narratora dla nowej postaci, po kolei. Kod wie, kiedy i gdzie pokazać kwestię o danym id, więc każde id jest dokładnie raz (sprawdza to też walidacja).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skipLabel",
    "nextLabel",
    "lines"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "skipLabel": {
      "type": "string",
      "minLength": 1
    },
    "nextLabel": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "enum": [
              "intro",
              "time",
              "tap-region",
              "tap-area",
              "tap-start",
              "skip",
              "tap-skip",
              "tap-claim",
              "report",
              "report-summary",
              "report-system",
              "report-fights",
              "report-items",
              "report-account",
              "tap-character",
              "character",
              "tap-stats",
              "tap-points",
              "tap-camp",
              "camp",
              "camp-sawmill",
              "tap-plot",
              "tap-build",
              "camp-countdown",
              "ending"
            ]
          },
          "kind": {
            "enum": [
              "card",
              "point",
              "tap"
            ],
            "description": "card: pergamin, który narrator czyta. point: sam narrator przy podświetlonym miejscu, z przyciskiem „Dalej”. tap: sam narrator przy miejscu, które trzeba stuknąć."
          },
          "text": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "voice": {
            "type": "string",
            "pattern": "^audio/narration/[a-z0-9-]+\\.mp3$",
            "description": "Nagranie kwestii, gdy już jest."
          }
        }
      }
    }
  }
}
