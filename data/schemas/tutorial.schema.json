{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wprowadzenie narratora",
  "description": "Kwestie narratora dla nowej postaci, po kolei. Kod wie, kiedy i gdzie pokazać kwestię o danym id, więc każde id jest dokładnie raz (sprawdza to też walidacja).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skipLabel",
    "nextLabel",
    "startLabel",
    "recommendedLabel",
    "authorLabel",
    "hideLabel",
    "showLabel",
    "skippedText",
    "firstSteps",
    "chapters",
    "lines"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "skipLabel": {
      "type": "string",
      "minLength": 1
    },
    "nextLabel": {
      "type": "string",
      "minLength": 1
    },
    "startLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Pierwsza karta (ask): przejdź wprowadzenie."
    },
    "recommendedLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Mniejszy napis pod startLabel."
    },
    "authorLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Podpis karty od autora gry (speaker: author) w miejscu „Narrator”."
    },
    "hideLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Zwija pergamin, żeby odsłonić ekran; narrator czyta dalej."
    },
    "showLabel": {
      "type": "string",
      "minLength": 1,
      "description": "Rozwija ukryty pergamin z powrotem."
    },
    "skippedText": {
      "type": "string",
      "minLength": 1,
      "description": "Komunikat po „Pomiń wprowadzenie”."
    },
    "firstSteps": {
      "type": "object",
      "description": "Co narrator każe zrobić na początku: pierwsza wyprawa (najdłuższa dostępna na starcie, przewinięta Punktami Czasu) i pierwszy budynek. Po „Pomiń wprowadzenie” serwer robi to za gracza, żeby obie drogi dawały ten sam start.",
      "additionalProperties": false,
      "required": [
        "areaId",
        "buildingId"
      ],
      "properties": {
        "areaId": {
          "type": "string",
          "minLength": 1
        },
        "buildingId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chapters": {
      "type": "object",
      "description": "Części po wprowadzeniu: każda ma swój przycisk pomijania i komunikat po nim. Kwestie należą do części przez chapter.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skipLabel",
          "skippedText"
        ],
        "properties": {
          "skipLabel": {
            "type": "string",
            "minLength": 1,
            "description": "Pomija tylko tę część."
          },
          "skippedText": {
            "type": "string",
            "minLength": 1,
            "description": "Komunikat po pominięciu."
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "enum": [
              "ask",
              "intro",
              "purpose",
              "test",
              "tap-region",
              "tap-area",
              "bestiary",
              "trial",
              "tap-start",
              "skip",
              "tap-skip",
              "tap-claim",
              "report",
              "report-summary",
              "report-system",
              "report-fights",
              "report-items",
              "report-account",
              "lead-character",
              "character",
              "lead-stats",
              "stats",
              "free-points",
              "lead-camp",
              "camp",
              "camp-sawmill",
              "camp-quarry",
              "camp-lake",
              "camp-anvil",
              "camp-loot-shed",
              "camp-craft-table",
              "camp-level",
              "lead-campfire",
              "tap-build",
              "camp-countdown",
              "wallet",
              "settings",
              "quests",
              "encyclopedia-lead",
              "encyclopedia",
              "ending",
              "skills-welcome",
              "skills-lead-character",
              "skills-lead",
              "skills-intro",
              "skills-paths",
              "skills-card",
              "skills-choice",
              "skills-points",
              "skills-evolution",
              "skills-ending",
              "professions-welcome",
              "professions-lead",
              "professions-intro",
              "professions-list",
              "professions-ending",
              "community-welcome",
              "community-lead",
              "community-rules",
              "community-ending",
              "crafting-welcome",
              "crafting-lead",
              "crafting-patterns",
              "crafting-ending",
              "settlement-welcome",
              "settlement-lead",
              "settlement-board",
              "settlement-brotherhoods",
              "settlement-ending",
              "evolution-welcome",
              "evolution-lead",
              "evolution-choice",
              "evolution-points",
              "evolution-ending"
            ]
          },
          "kind": {
            "enum": [
              "card",
              "point",
              "lead",
              "tap"
            ],
            "description": "card: pergamin na środku ekranu, dla kwestii ogólnych. point: pergamin przy podświetlonym miejscu, o którym mówi kwestia, z przyciskiem „Dalej”. lead: pergamin przy miejscu, które trzeba stuknąć. tap: sam narrator z poleceniem w dymku przy miejscu, które trzeba stuknąć."
          },
          "text": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "voice": {
            "type": "string",
            "pattern": "^audio/narration/[a-z0-9-]+\\.mp3$",
            "description": "Nagranie kwestii, gdy już jest."
          },
          "once": {
            "const": true,
            "description": "Tylko przy kwestii lead: po stuknięciu zostaje zapamiętana jak karta, bo stuknięcie nie zmienia ekranu (portfel pod złotem w górnym pasku)."
          },
          "speaker": {
            "const": "author",
            "description": "Karta od autora gry, nie od narratora: bez postaci narratora i bez nagrania."
          },
          "female": {
            "type": "object",
            "description": "Kwestia dla postaci o wyglądzie kobiecym, gdy narrator mówi do gracza w rodzaju męskim: ten sam tekst z żeńskimi końcówkami i jego nagranie.",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "voice": {
                "type": "string",
                "pattern": "^audio/narration/[a-z0-9-]+\\.mp3$",
                "description": "Nagranie kwestii, gdy już jest."
              }
            }
          },
          "chapter": {
            "enum": [
              "skills",
              "professions",
              "community",
              "crafting",
              "settlement",
              "evolution"
            ],
            "description": "Część po wprowadzeniu, do której należy kwestia (chapters). Jej kwestie przychodzą dopiero po zakończeniu wprowadzenia, w swoim momencie gry."
          },
          "classes": {
            "type": "object",
            "description": "Tekst kwestii dla każdej klasy z data/classes.json (walidacja sprawdza, że żadnej nie brakuje), gdy narrator mówi o klasie postaci. Zastępuje text.",
            "additionalProperties": false,
            "propertyNames": {
              "pattern": "^[a-z]+$"
            },
            "patternProperties": {
              "^[a-z]+$": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "voice": {
                    "type": "string",
                    "pattern": "^audio/narration/[a-z0-9-]+\\.mp3$",
                    "description": "Nagranie kwestii, gdy już jest."
                  },
                  "female": {
                    "type": "object",
                    "description": "Kwestia dla postaci o wyglądzie kobiecym, gdy narrator mówi do gracza w rodzaju męskim: ten sam tekst z żeńskimi końcówkami i jego nagranie.",
                    "additionalProperties": false,
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "voice": {
                        "type": "string",
                        "pattern": "^audio/narration/[a-z0-9-]+\\.mp3$",
                        "description": "Nagranie kwestii, gdy już jest."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "classes"
            ]
          }
        ]
      }
    }
  }
}
