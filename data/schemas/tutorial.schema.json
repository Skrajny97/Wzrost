{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wprowadzenie narratora",
  "description": "Karty narratora dla nowej postaci. Kod pokazuje kartę według jej id, więc każda z siedmiu kart musi być dokładnie raz.",
  "type": "object",
  "additionalProperties": false,
  "required": ["skipLabel", "nextLabel", "cards"],
  "properties": {
    "$comment": { "type": "string" },
    "skipLabel": { "type": "string", "minLength": 1 },
    "nextLabel": { "type": "string", "minLength": 1 },
    "cards": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "enum": ["intro", "time", "skip", "report", "character", "camp", "ending"] },
          "text": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "voice": { "type": "string", "pattern": "^audio/narration/[a-z0-9-]+\\.mp3$", "description": "Nagranie głosu narratora, gdy już jest." }
        }
      }
    }
  }
}
