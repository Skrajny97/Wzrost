{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bazy przedmiotów",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "gender", "slot", "kind"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "gender": { "enum": ["m", "f", "n", "pl"] },
      "slot": { "type": "string" },
      "kind": { "enum": ["weapon", "armor", "implicit"] },
      "attackName": { "type": "string", "minLength": 1 },
      "category": { "enum": ["physical", "magical"] },
      "scaling": { "type": "string" },
      "elements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "damageFactor": { "type": "number", "exclusiveMinimum": 0 },
      "variance": { "type": "number", "minimum": 0, "maximum": 0.9 },
      "armorFactor": { "type": "number", "exclusiveMinimum": 0 },
      "stat": { "type": "string" },
      "statFactor": { "type": "number", "exclusiveMinimum": 0 },
      "sound": { "type": "string", "description": "Rodzaj dźwięku trafienia z sounds.json." },
      "family": {
        "description": "Kategoria przedmiotu w grze, jak w Metin2 (np. talizmany): id pierwszej bazy tej kategorii, z tym samym miejscem i rodzajem. Pierwsza baza kategorii nie ma tego pola.",
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "classLevel": {
        "description": "Poziom klasy, od którego postać może używać tej bazy. Na wyprawach baza wypada tylko tam, gdzie zakres poziomów miejsca sięga tego poziomu, a w cotygodniowej skrzyni od tego poziomu klasy postaci. Tylko dla dalszych baz kategorii (z polem family).",
        "type": "integer",
        "minimum": 2
      },
      "bonus": {
        "description": "Premia +x dalszej bazy kategorii: stała liczba losowana z zakresu przy znalezieniu i dodawana do liczb pierwszej bazy (obrażeń broni, pancerza albo statystyki). Dalsza baza ma ten sam współczynnik co pierwsza, więc przewaga nie rośnie z poziomem przedmiotu.",
        "type": "object",
        "required": ["min", "max"],
        "additionalProperties": false,
        "properties": {
          "min": { "type": "integer", "minimum": 1 },
          "max": { "type": "integer", "minimum": 1 }
        }
      },
      "strike": {
        "description": "Wygląd ciosu w animacji walki. Bez tego pola broń fizyczna uderza wręcz, a magiczna wystrzeliwuje pocisk.",
        "enum": ["melee", "arrow", "magic"]
      }
    },
    "allOf": [
      {
        "if": { "properties": { "kind": { "const": "weapon" } } },
        "then": {
          "required": ["attackName", "category", "scaling", "damageFactor", "variance"],
          "if": { "properties": { "category": { "const": "magical" } } },
          "then": { "required": ["elements"] }
        }
      },
      { "if": { "properties": { "kind": { "const": "armor" } } }, "then": { "required": ["armorFactor"] } },
      { "if": { "properties": { "kind": { "const": "implicit" } } }, "then": { "required": ["stat", "statFactor"] } }
    ]
  }
}
