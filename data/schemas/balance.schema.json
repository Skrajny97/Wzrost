{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stałe balansu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "combat",
    "character",
    "monsters",
    "items",
    "hunt",
    "rewards",
    "regen",
    "progression"
  ],
  "properties": {
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kBase",
        "kPerLevel",
        "scalingMax",
        "armorPerEndurance",
        "dodgePerDexterity",
        "dodgeCap",
        "critPerPerception",
        "critCap",
        "critMultiplier",
        "willPerPoint",
        "willCap",
        "speedMax",
        "speedKBase",
        "speedKPerLevel",
        "moveTime",
        "maxConsecutiveMoves",
        "maxActions",
        "targetWeights",
        "unarmed"
      ],
      "properties": {
        "kBase": {
          "type": "number",
          "minimum": 0
        },
        "kPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "scalingMax": {
          "type": "number",
          "minimum": 0,
          "description": "Najwyższa premia do obrażeń ze statystyki broni (2,5 to +250%). Rośnie z malejącym zwrotem P / (P + K), gdzie K zależy od poziomu atakującego."
        },
        "armorPerEndurance": {
          "type": "number",
          "minimum": 0
        },
        "dodgePerDexterity": {
          "type": "number",
          "minimum": 0
        },
        "dodgeCap": {
          "type": "number",
          "minimum": 0
        },
        "critPerPerception": {
          "type": "number",
          "minimum": 0
        },
        "critCap": {
          "type": "number",
          "minimum": 0
        },
        "critMultiplier": {
          "type": "number",
          "minimum": 0
        },
        "willPerPoint": {
          "type": "number",
          "minimum": 0
        },
        "willCap": {
          "type": "number",
          "minimum": 0
        },
        "speedMax": {
          "type": "number",
          "minimum": 0
        },
        "speedKBase": {
          "type": "number",
          "minimum": 0
        },
        "speedKPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "moveTime": {
          "type": "number",
          "minimum": 0
        },
        "maxConsecutiveMoves": {
          "type": "number",
          "minimum": 0
        },
        "maxActions": {
          "type": "number",
          "minimum": 0
        },
        "targetWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "front",
            "middle",
            "back"
          ],
          "properties": {
            "front": {
              "type": "number",
              "minimum": 0
            },
            "middle": {
              "type": "number",
              "minimum": 0
            },
            "back": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "unarmed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attackName",
            "damageFactor",
            "variance"
          ],
          "properties": {
            "attackName": {
              "type": "string",
              "minLength": 1
            },
            "damageFactor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "variance": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.9
            }
          },
          "description": "Walka bez broni: obrażenia rosną z poziomem jak u broni pospolitej, z mnożnikiem damageFactor."
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hpBase",
        "hpPerVitality",
        "hpPerLevel",
        "manaBase",
        "manaPerWisdom"
      ],
      "properties": {
        "hpBase": {
          "type": "number",
          "minimum": 0
        },
        "hpPerVitality": {
          "type": "number",
          "minimum": 0
        },
        "hpPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "manaBase": {
          "type": "number",
          "minimum": 0
        },
        "manaPerWisdom": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budgetBase",
        "budgetPerLevel",
        "emptySlotWeight",
        "damageBase",
        "damagePerBudget",
        "armorPerBudget",
        "statPerBudget",
        "resistancePerBudget",
        "sellGoldPerLevel"
      ],
      "properties": {
        "budgetBase": {
          "type": "number",
          "minimum": 0
        },
        "budgetPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "emptySlotWeight": {
          "type": "number",
          "minimum": 1,
          "description": "Ile razy częściej łup trafia w slot, który postać ma pusty."
        },
        "damageBase": {
          "type": "number",
          "minimum": 0
        },
        "damagePerBudget": {
          "type": "number",
          "minimum": 0
        },
        "armorPerBudget": {
          "type": "number",
          "minimum": 0
        },
        "statPerBudget": {
          "type": "number",
          "minimum": 0
        },
        "resistancePerBudget": {
          "type": "number",
          "minimum": 0
        },
        "sellGoldPerLevel": {
          "type": "number",
          "minimum": 0,
          "description": "Cena u złomiarza: poziom przedmiotu × ta wartość × mnożnik rzadkości (sell w rarities.json)."
        }
      }
    },
    "hunt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minMinutes",
        "stepMinutes",
        "maxMinutes",
        "shortHuntMaxMinutes",
        "fightsByMinutes",
        "minutesPerFightReference",
        "toughChanceByMinutes",
        "toughLevelBonus",
        "findIntervalMinutes",
        "eliteChancePerFight",
        "eliteLevelBonus",
        "recoveryAfterFight",
        "soloXpBonus",
        "lowLevelFreeDiff",
        "lowLevelStepPenalty",
        "lowLevelMinMultiplier",
        "faintXpPenalty",
        "hpAfterFaint",
        "groupFactors",
        "monsterLevelWeights",
        "beginnerLevel",
        "areaUnlockLead"
      ],
      "properties": {
        "minMinutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Najkrótsza wyprawa w minutach."
        },
        "stepMinutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Krok suwaka czasu wyprawy w minutach (po najkrótszej)."
        },
        "maxMinutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Najdłuższa wyprawa w minutach, po odblokowaniu długich eksploracji."
        },
        "shortHuntMaxMinutes": {
          "type": "number",
          "minimum": 0,
          "description": "Najdłuższa wyprawa dostępna przed odblokowaniem długich eksploracji (unlocks.json, long-hunts)."
        },
        "fightsByMinutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0 }
          },
          "description": "Pary [minuty, walki]: wyprawa ma tyle walk, ile podaje para o największej liczbie minut nie większej niż jej czas."
        },
        "minutesPerFightReference": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Ile minut wyprawy stanowi jedna walka przy pełnej nagrodzie. Walka dłuższej wyprawy daje odpowiednio więcej XP, złota i szans na łup."
        },
        "toughChanceByMinutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0 }
          },
          "description": "Pary [minuty, szansa]: szansa, że walka jest wymagającym spotkaniem; między parami rośnie z logarytmem czasu."
        },
        "toughLevelBonus": {
          "type": "integer",
          "minimum": 0,
          "description": "O ile poziomów wymagające spotkanie przewyższa zwykłe."
        },
        "monsterLevelWeights": {
          "type": "array",
          "description": "Wagi poziomów potworów w regionie wewnętrznym, od najniższego: niższe poziomy trafiają się częściej.",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "beginnerLevel": {
          "type": "integer",
          "minimum": 0,
          "description": "Do tego poziomu postaci przeciwnicy mają najniższy poziom regionu wewnętrznego (pierwsze minuty gry, pierwsza walka bez broni)."
        },
        "areaUnlockLead": {
          "type": "integer",
          "minimum": 0,
          "description": "Region wewnętrzny otwiera się, gdy poziom klasy dojdzie do jego najniższego poziomu minus tyle. Przy 1 klasa na poziomie 5 może iść do miejsca z poziomami 6–10."
        },
        "findIntervalMinutes": {
          "type": "number",
          "minimum": 0,
          "description": "Średni odstęp między znaleziskami w minutach wyprawy."
        },
        "eliteChancePerFight": {
          "type": "number",
          "minimum": 0
        },
        "eliteLevelBonus": {
          "type": "number",
          "minimum": 0
        },
        "recoveryAfterFight": {
          "type": "number",
          "minimum": 0
        },
        "soloXpBonus": {
          "type": "number",
          "minimum": 0
        },
        "lowLevelFreeDiff": {
          "type": "number",
          "minimum": 0
        },
        "lowLevelStepPenalty": {
          "type": "number",
          "minimum": 0
        },
        "lowLevelMinMultiplier": {
          "type": "number",
          "minimum": 0
        },
        "faintXpPenalty": {
          "type": "number",
          "minimum": 0
        },
        "hpAfterFaint": {
          "type": "number",
          "minimum": 0
        },
        "groupFactors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xpBase",
        "xpExponent",
        "eliteXpMultiplier",
        "goldPerLevel",
        "eliteGoldMultiplier",
        "itemDropChance",
        "eliteRarityBonus",
        "toughRarityBonus",
        "toughDropMultiplier",
        "findOutcomes",
        "findGoldPerLevel"
      ],
      "properties": {
        "xpBase": {
          "type": "number",
          "minimum": 0
        },
        "xpExponent": {
          "type": "number",
          "minimum": 0
        },
        "eliteXpMultiplier": {
          "type": "number",
          "minimum": 0
        },
        "goldPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "eliteGoldMultiplier": {
          "type": "number",
          "minimum": 0
        },
        "itemDropChance": {
          "type": "number",
          "minimum": 0
        },
        "eliteRarityBonus": {
          "type": "number",
          "minimum": 0
        },
        "toughRarityBonus": {
          "type": "number",
          "minimum": 0,
          "description": "Mnożnik szansy na wyższą rzadkość łupu z wymagającego spotkania."
        },
        "toughDropMultiplier": {
          "type": "number",
          "minimum": 0,
          "description": "Mnożnik szansy na łup z wymagającego spotkania."
        },
        "findOutcomes": {
          "type": "object",
          "description": "Wagi wyniku znaleziska: złoto, przedmiot albo nic ciekawego.",
          "additionalProperties": false,
          "required": [
            "gold",
            "item",
            "nothing"
          ],
          "properties": {
            "gold": {
              "type": "number",
              "minimum": 0
            },
            "item": {
              "type": "number",
              "minimum": 0
            },
            "nothing": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "findGoldPerLevel": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "regen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perMinute",
        "perVitalityPerMinute"
      ],
      "properties": {
        "perMinute": {
          "type": "number",
          "minimum": 0
        },
        "perVitalityPerMinute": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLevel",
        "firstLevelMinutes",
        "flatLevels",
        "levelTimeExponent",
        "xpPerHourScale",
        "classXpFactor",
        "freeResetMaxLevel",
        "classEvolutionLevel"
      ],
      "properties": {
        "maxLevel": {
          "type": "number",
          "minimum": 0
        },
        "firstLevelMinutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minuty eksploracji na każdy z pierwszych poziomów. Poziom L trwa firstLevelMinutes × max(1, L / flatLevels)^levelTimeExponent minut."
        },
        "flatLevels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "levelTimeExponent": {
          "type": "number",
          "minimum": 0
        },
        "xpPerHourScale": {
          "type": "number",
          "minimum": 0
        },
        "classXpFactor": {
          "type": "number",
          "minimum": 0
        },
        "freeResetMaxLevel": {
          "type": "number",
          "minimum": 0
        },
        "classEvolutionLevel": {
          "type": "integer",
          "minimum": 2,
          "description": "Poziom klasy pierwszej ewolucji."
        }
      }
    },
    "monsters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hpBase",
        "budgetBase",
        "damageMultiplier",
        "gearLagMinutes"
      ],
      "properties": {
        "hpBase": {
          "type": "number",
          "minimum": 0
        },
        "budgetBase": {
          "type": "number",
          "minimum": 0
        },
        "damageMultiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gearLagMinutes": {
          "type": "number",
          "minimum": 0,
          "description": "Naturalne uzbrojenie potwora odpowiada przedmiotom z poziomu, który postać miała tyle minut eksploracji wcześniej."
        }
      }
    }
  }
}
