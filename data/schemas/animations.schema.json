{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Animacje oczekiwania",
  "description": "Zapętlone sceny podczas pracy w profesji i wyprawy. Arkusz to jeden rząd kwadratowych klatek po size pikseli, pokazany w podwójnej wielkości. Rzadkie zdarzenie pracy (moment) to ptak nad sceną albo para lub iskry z punktu x, y klatki. W Walce postać idzie w miejscu po dróżce, a kraina regionu wyprawy przesuwa się za nią: kraina o landSpeed, a dróżka o pathSpeed pikseli na sekundę. Pierwsze rzadkie zdarzenie przychodzi po firstSeconds, kolejne po seconds (losowo między dwiema liczbami). dayParts: światło sceny od danej godziny w Polsce.",
  "type": "object",
  "additionalProperties": false,
  "required": ["work", "walk", "bird", "moments", "dayParts"],
  "definitions": {
    "point": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "sheet": {
      "type": "object",
      "required": ["file", "size", "frames", "fps"],
      "properties": {
        "file": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
        "size": { "type": "integer", "minimum": 8 },
        "frames": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "range": { "type": "array", "items": { "type": "number", "minimum": 1 }, "minItems": 2, "maxItems": 2 }
  },
  "properties": {
    "$comment": { "type": "string" },
    "work": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/definitions/sheet" },
          {
            "properties": {
              "file": true,
              "size": true,
              "frames": true,
              "fps": true,
              "scale": { "type": "integer", "minimum": 1, "description": "Ile razy powiększyć klatkę, gdy nie dwa (sceny Kopalni i Szlifierni, rysowane w 256 pikselach, w swojej wielkości)." },
              "place": { "type": "string" },
              "moment": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["bird", "steam", "sparks"] },
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "walk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure", "walker", "path", "lands", "landSpeed", "pathSpeed", "moments"],
      "properties": {
        "figure": { "$ref": "#/definitions/sheet" },
        "rider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "seat"],
          "description": "Jeździec (tools/ride-skeleton.py): rozmiar obrazka i punkt, którym siedzi w siodle.",
          "properties": {
            "width": { "type": "integer", "minimum": 8 },
            "height": { "type": "integer", "minimum": 8 },
            "seat": { "$ref": "#/definitions/point" }
          }
        },
        "mounts": {
          "type": "object",
          "description": "Kłus wierzchowców ze Stajni w scenie Walki, po id wierzchowca (data/settlement.json) albo wyglądu wierzchowca ze Sklepu Systemu (sabertooth): arkusz klatek w rzędzie i miejsce siodła w każdej klatce (tools/ride-sheets.py).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "width", "height", "frames", "fps", "seats"],
            "properties": {
              "file": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
              "width": { "type": "integer", "minimum": 8 },
              "height": { "type": "integer", "minimum": 8 },
              "frames": { "type": "integer", "minimum": 1 },
              "fps": { "type": "number", "exclusiveMinimum": 0 },
              "seats": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/point" } }
            }
          }
        },
        "walker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "frames", "fps", "scale"],
          "properties": {
            "size": { "type": "integer", "minimum": 8 },
            "frames": { "type": "integer", "minimum": 1 },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "scale": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "path": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
        "lands": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^art/scenes/.+\\.png$" } },
        "landSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "pathSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "moments": { "type": "array", "items": { "enum": ["bird", "shadow"] } }
      }
    },
    "bird": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
    "moments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstSeconds", "seconds"],
      "properties": {
        "firstSeconds": { "$ref": "#/definitions/range" },
        "seconds": { "$ref": "#/definitions/range" }
      }
    },
    "dayParts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from"],
        "properties": {
          "id": { "enum": ["dawn", "day", "dusk", "night"] },
          "from": { "type": "integer", "minimum": 0, "maximum": 23 }
        }
      }
    }
  }
}
