{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Animacje oczekiwania",
  "description": "Zapętlone sceny podczas pracy w profesji i wyprawy. Arkusz to jeden rząd kwadratowych klatek po size pikseli, pokazany w podwójnej wielkości. Rzadkie zdarzenie pracy (moment) to ptak nad sceną albo para lub iskry z punktu x, y klatki. W Walce postać idzie w miejscu po dróżce, a kraina regionu wyprawy przesuwa się za nią: kraina o landSpeed, a dróżka o pathSpeed pikseli na sekundę. Pierwsze rzadkie zdarzenie przychodzi po firstSeconds, kolejne po seconds (losowo między dwiema liczbami). dayParts: światło sceny od danej godziny w Polsce.",
  "type": "object",
  "additionalProperties": false,
  "required": ["work", "walk", "bird", "moments", "dayParts"],
  "definitions": {
    "point": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "sheet": {
      "type": "object",
      "required": ["file", "size", "frames", "fps"],
      "properties": {
        "file": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
        "size": { "type": "integer", "minimum": 8 },
        "frames": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "range": { "type": "array", "items": { "type": "number", "minimum": 1 }, "minItems": 2, "maxItems": 2 }
  },
  "properties": {
    "$comment": { "type": "string" },
    "work": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/definitions/sheet" },
          {
            "properties": {
              "file": true,
              "size": true,
              "frames": true,
              "fps": true,
              "scale": { "type": "integer", "minimum": 1, "description": "Ile razy powiększyć klatkę, gdy nie dwa (sceny Kopalni i Szlifierni, rysowane w 256 pikselach, w swojej wielkości)." },
              "place": { "type": "string" },
              "moment": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["bird", "steam", "sparks"] },
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "cultivation": {
      "description": "Scena Kultywacji (src/client/cultivation.js): arkusz klatek jak scena pracy, zapętlony na ekranie Kultywacji i przyciemniony za słowami jej karty w Walce.",
      "allOf": [
        { "$ref": "#/definitions/sheet" },
        {
          "properties": {
            "file": true,
            "size": true,
            "frames": true,
            "fps": true,
            "scale": { "type": "integer", "minimum": 1, "description": "Ile razy powiększyć klatkę, gdy nie dwa (scena rysowana w 256 pikselach, w swojej wielkości)." }
          },
          "additionalProperties": false
        }
      ]
    },
    "walk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure", "walker", "path", "lands", "landSpeed", "pathSpeed", "moments"],
      "properties": {
        "figure": { "$ref": "#/definitions/sheet" },
        "rider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "seat"],
          "description": "Jeździec (tools/ride-skeleton.py): rozmiar obrazka i punkt, którym siedzi w siodle. large: większe płótno dla jeźdźców z listy ids (wysoki hełm, łuk albo peleryna nie mieszczą się w zwykłym), z własnym punktem siodła.",
          "properties": {
            "width": { "type": "integer", "minimum": 8 },
            "height": { "type": "integer", "minimum": 8 },
            "seat": { "$ref": "#/definitions/point" },
            "large": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height", "seat", "ids"],
              "properties": {
                "width": { "type": "integer", "minimum": 8 },
                "height": { "type": "integer", "minimum": 8 },
                "seat": { "$ref": "#/definitions/point" },
                "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" } }
              }
            },
            "nudge": {
              "type": "object",
              "description": "Przesunięcie jeźdźca na jednym wierzchowcu w pikselach [x, y] (x > 0 w prawo, y < 0 w górę), po wyglądzie jeźdźca i id kłusa w walk.mounts, gdy na tym jednym siedzi źle, a na pozostałych dobrze.",
              "propertyNames": { "pattern": "^[a-z]+(-[a-z]+)*$" },
              "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/definitions/point" } }
            }
          }
        },
        "mounts": {
          "type": "object",
          "description": "Kłus wierzchowców ze Stajni w scenie Walki, po id wierzchowca (data/settlement.json) albo wyglądu wierzchowca ze Sklepu Systemu (sabertooth): arkusz klatek w rzędzie i miejsce siodła w każdej klatce (tools/ride-sheets.py).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "width", "height", "frames", "fps", "seats"],
            "properties": {
              "file": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
              "width": { "type": "integer", "minimum": 8 },
              "height": { "type": "integer", "minimum": 8 },
              "scale": { "type": "number", "exclusiveMinimum": 0, "description": "Ile razy większy wierzchowiec stoi w scenie niż na arkuszu, z siodłem w tej samej skali; jeździec zostaje w swojej. Kuc 1,2 (autor 10.11.2026: „kuc jest za mały albo postacie za duże”)." },
              "frames": { "type": "integer", "minimum": 1 },
              "fps": { "type": "number", "exclusiveMinimum": 0 },
              "seats": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/point" } },
              "afoot": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "W jakiej skali idą piesi obok jeźdźca na tym wierzchowcu, gdy nie 0,7 (659 B): przy Kucu 0,85, bo jest dużo niższy od konia (1081 B; autor: „za duże sa niektore postaci na kucach nadal w porównaniu do towarzyszy chociażby”). Przy kilku jeźdźcach liczy się najmniejsza." },
              "reins": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "bits", "hands", "riders"],
                "description": "Wodze jako osobna warstwa nad kłusem i pod jeźdźcem (tools/reindeer-reins.py, scenes.js ride): file to wodze, które trzyma większość jeźdźców, od wędzidła (bits, jedno na klatkę) do miejsca dłoni (siodło przesunięte o hands); riders to jeźdźcy z własnymi wodzami w dłoni, z końcami ich pasków na ich własnym obrazku, i każdy ma obok file swój obrazek <file>-<wygląd>.png. Autor 17.11.2026: „jeden sznur wodzy na reniferze wisi w powietrzu”.",
                "properties": {
                  "file": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
                  "bits": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/point" } },
                  "hands": { "$ref": "#/definitions/point" },
                  "riders": { "type": "object", "propertyNames": { "pattern": "^[a-z]+(-[a-z]+)*$" }, "additionalProperties": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/definitions/point" } } }
                }
              }
            }
          }
        },
        "walker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "frames", "fps", "scale"],
          "properties": {
            "size": { "type": "integer", "minimum": 8 },
            "frames": { "type": "integer", "minimum": 1 },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "scale": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "path": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
        "lands": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^art/scenes/.+\\.png$" } },
        "landSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "pathSpeed": { "type": "number", "exclusiveMinimum": 0 },
        "moments": { "type": "array", "items": { "enum": ["bird", "shadow"] } }
      }
    },
    "bird": { "type": "string", "pattern": "^art/scenes/.+\\.png$" },
    "moments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstSeconds", "seconds"],
      "properties": {
        "firstSeconds": { "$ref": "#/definitions/range" },
        "seconds": { "$ref": "#/definitions/range" }
      }
    },
    "dayParts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from"],
        "properties": {
          "id": { "enum": ["dawn", "day", "dusk", "night"] },
          "from": { "type": "integer", "minimum": 0, "maximum": 23 }
        }
      }
    }
  }
}
