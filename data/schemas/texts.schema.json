{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Teksty raportów",
  "type": "object",
  "required": [
    "fightStart", "eliteStart", "championStart", "toughStart", "hit", "crit", "dodge", "effectApplied", "effectTick", "kill", "skillHit", "skillCrit", "skillDodge", "skillUse", "skillBuff", "skillBuffShared", "skillCoat", "skillShield", "skillEvade", "skillHeal", "stun", "slow", "slowOne", "mired", "drain", "weakness", "absorbed", "counter", "counterCrit", "skillPoints", "skillCostActive", "skillCostStart", "skillCostOnce", "victory", "defeat",
    "escape", "draw", "recover", "findGold", "findChest", "findResource", "gathered", "findNothing", "findTime", "materials", "eliteChest", "championChest", "firstChest", "levelUp", "classLevelUp", "statPointsGained", "statPointsWaiting", "timePointsGained", "classWaitsPath", "classWaitsPoints", "levelHeal", "levelHealFemale", "faintPenalty", "bagOverflow", "autoEquip", "pushHuntTitle", "pushHuntBody", "pushBuildTitle", "pushBuildBody", "pushStoreTitle", "pushStoreBody", "emailConfirmSubject", "emailConfirmIntro", "emailConfirmButton", "emailConfirmReward", "emailConfirmLink", "emailConfirmIgnore", "lengths", "result",
    "skillBuffSpeed", "skillCoatWeaken", "skillShieldReflect", "skillEvadeBlades", "guardReflect", "skillRiposte", "stanceFrenzy", "stanceProvoke", "stanceCloud", "stancePet", "stanceRegen", "cloudStrike", "reflect", "lifesteal", "regen", "renewalHot", "miracle", "cleansed", "summonUp", "summonHit", "summonTaken", "summonSpit", "summonGone", "summonFell", "summonBurst", "marked", "doomed", "echo", "charged", "armorShred",
    "stunMoves", "vanished", "blocked", "ovation", "skillShieldParty", "skillShieldSlow", "skillHarmony", "summonStrike", "summonMiss", "summonRisen", "duel", "locked", "stanceRoar", "stanceWall", "stanceOrb", "stanceAura", "stancePyre", "pyreStrike", "stanceChoir", "stanceVanish", "stanceDouble"
  ],
  "properties": {
    "lengths": {
      "description": "Nazwy długości wyprawy przy suwaku: każda obejmuje czas do upTo minut, ostatnia resztę.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "upTo": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "fainted", "escaped"],
      "properties": {
        "success": { "type": "string", "minLength": 1 },
        "fainted": { "type": "string", "minLength": 1 },
        "escaped": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
}
