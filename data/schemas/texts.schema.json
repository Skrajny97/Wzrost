{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Teksty raportów",
  "type": "object",
  "required": [
    "fightStart", "eliteStart", "toughStart", "hit", "crit", "dodge", "effectApplied", "effectTick", "kill", "skillHit", "skillCrit", "skillDodge", "skillUse", "skillBuff", "skillBuffShared", "skillCoat", "skillShield", "skillEvade", "skillHeal", "stun", "slow", "slowOne", "absorbed", "counter", "counterCrit", "skillPoints", "skillCostActive", "skillCostStart", "skillCostOnce", "victory", "defeat",
    "escape", "draw", "recover", "findGold", "findChest", "findResource", "gathered", "findNothing", "findTime", "materials", "eliteChest", "firstChest", "levelUp", "classLevelUp", "classLevelUpLocked", "classWaitsPath", "classWaitsPoints", "levelHeal", "faintPenalty", "bagOverflow", "autoEquip", "pushHuntTitle", "pushHuntBody", "pushBuildTitle", "pushBuildBody", "pushStoreTitle", "pushStoreBody", "lengths", "result"
  ],
  "properties": {
    "lengths": {
      "description": "Nazwy długości wyprawy przy suwaku: każda obejmuje czas do upTo minut, ostatnia resztę.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "upTo": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "fainted", "escaped"],
      "properties": {
        "success": { "type": "string", "minLength": 1 },
        "fainted": { "type": "string", "minLength": 1 },
        "escaped": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
}
