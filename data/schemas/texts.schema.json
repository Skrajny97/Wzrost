{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Teksty raportów",
  "type": "object",
  "required": [
    "fightStart", "eliteStart", "hit", "crit", "dodge", "effectApplied", "effectTick", "kill", "victory", "defeat",
    "escape", "draw", "recover", "findGold", "findItem", "loot", "levelUp", "classLevelUp", "classLevelUpLocked", "faintPenalty", "result"
  ],
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "fainted", "escaped"],
      "properties": {
        "success": { "type": "string", "minLength": 1 },
        "fainted": { "type": "string", "minLength": 1 },
        "escaped": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
}
