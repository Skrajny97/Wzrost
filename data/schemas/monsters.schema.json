{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Potwory",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "counted", "family", "position", "stats", "attack", "hpFactor", "armorFactor", "reward"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "counted": {
        "type": "array",
        "description": "Nazwa po liczbie, w bierniku, do zadań narratora: 1 (wilka), 2–4 (wilki), 5 i więcej (wilków).",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "string", "minLength": 1 }
      },
      "family": { "type": "string", "minLength": 1 },
      "position": { "enum": ["front", "middle", "back"] },
      "elite": { "type": "boolean" },
      "champion": { "type": "boolean", "description": "Czempion: najsilniejszy stwór regionu. Spotyka się go tylko w regionie wewnętrznym, który go wskazuje (champion w regions.json)." },
      "ambush": { "type": "boolean", "description": "Zasadzka (464): walka, w której jest ten stwór, zaczyna się od ruchów stworów, wszystkich przed pierwszym ruchem drużyny, jak zasadzka w zdarzeniach." },
      "stats": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base", "growth"],
        "properties": {
          "base": { "$ref": "#/definitions/statMap" },
          "growth": { "$ref": "#/definitions/statMap" }
        }
      },
      "attack": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "scaling", "damageFactor", "variance"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["physical", "magical"] },
          "element": { "type": "string" },
          "scaling": { "type": "string" },
          "damageFactor": { "type": "number", "exclusiveMinimum": 0 },
          "variance": { "type": "number", "minimum": 0, "maximum": 0.9 },
          "sound": { "type": "string", "description": "Rodzaj dźwięku trafienia z sounds.json." },
        "strike": { "enum": ["melee", "arrow", "magic"] },
          "dot": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "chance", "power", "ticks"],
            "properties": {
              "effect": { "type": "string" },
              "chance": { "type": "number", "minimum": 0, "maximum": 1 },
              "power": { "type": "number", "exclusiveMinimum": 0 },
              "ticks": { "type": "integer", "minimum": 1, "maximum": 10 },
              "all": { "type": "boolean", "description": "Na całą drużynę: efekt może dotknąć także każdego innego żywego członka drużyny, nie tylko trafionego, każdego z osobna (Ognista nawałnica Raroga)." }
            }
          },
          "target": { "enum": ["back"], "description": "Atak na tył szyku (463): stwór bije postać stojącą najdalej z tyłu, a gdy tył jest pusty, najdalej z tyłu z żywych." },
          "slow": {
            "type": "object",
            "description": "Ugrzęźnięcie: z szansą chance (mniejszą o Wolę celu) następny ruch celu przychodzi później, 1 / (1 - slow) razy później.",
            "additionalProperties": false,
            "required": ["effect", "chance", "slow"],
            "properties": {
              "effect": { "type": "string" },
              "chance": { "type": "number", "minimum": 0, "maximum": 1 },
              "slow": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.8 }
            }
          },
          "drain": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Wysysanie: stwór odzyskuje taką część obrażeń zadanych ciosem." }
        },
        "if": { "properties": { "category": { "const": "magical" } } },
        "then": { "required": ["element"] }
      },
      "hpFactor": { "type": "number", "exclusiveMinimum": 0 },
      "armorFactor": { "type": "number", "minimum": 0 },
      "resistances": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "perLevel"],
          "properties": { "base": { "type": "number", "minimum": 0 }, "perLevel": { "type": "number", "minimum": 0 } }
        }
      },
      "weaknesses": {
        "type": "object",
        "description": "Słabość na żywioł: o tyle więcej obrażeń od niego, np. 0.5 to o połowę więcej.",
        "additionalProperties": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      },
      "reward": {
        "type": "object",
        "additionalProperties": false,
        "required": ["xp", "gold"],
        "properties": { "xp": { "type": "number", "minimum": 0 }, "gold": { "type": "number", "minimum": 0 } }
      }
    }
  },
  "definitions": {
    "statMap": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
  }
}
