{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Talia Systemu",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "deckSize", "hand", "roundCap", "lines", "types", "typeBonus", "stats", "drops", "starter", "heroes", "stakes", "pack", "live", "host", "residents", "bonuses", "texts"],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "chance": { "type": "number", "minimum": 0, "maximum": 1 },
    "texts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "endTexts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Jak skończyła się partia na żywo: wszystkie karty zbite, koniec rund, poddanie, rundy bez ruchu albo rywal, który opuścił grę.",
      "properties": {
        "out": { "type": "string", "minLength": 1 },
        "cap": { "type": "string", "minLength": 1 },
        "surrender": { "type": "string", "minLength": 1 },
        "missed": { "type": "string", "minLength": 1 },
        "gone": { "type": "string", "minLength": 1 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monster", "level"],
      "properties": {
        "monster": { "$ref": "#/definitions/id" },
        "level": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "$comment": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "deckSize": { "type": "integer", "minimum": 3, "description": "Kart w talii." },
    "hand": { "type": "integer", "minimum": 1, "description": "Kart w rezerwie, dobieranych z talii." },
    "roundCap": { "type": "integer", "minimum": 1, "description": "Najwięcej rund partii." },
    "lines": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "description": "Trzy linie: przód, środek i tył.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": { "id": { "$ref": "#/definitions/id" }, "name": { "type": "string", "minLength": 1 } }
      }
    },
    "types": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "description": "Typy kart: statystyka ataku stwora (id), typ, który bije (target), i ikona.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "target", "icon"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "target": { "$ref": "#/definitions/id" },
          "icon": { "$ref": "#/definitions/id" }
        }
      }
    },
    "typeBonus": { "type": "number", "exclusiveMinimum": 0, "description": "O tyle więcej bije karta typu, który bije typ rywala." },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "life", "shapeExponent", "shapeRange", "landStep", "levelStep", "maxLevel", "rarity"],
      "properties": {
        "attack": { "type": "number", "exclusiveMinimum": 0 },
        "life": { "type": "number", "exclusiveMinimum": 0 },
        "shapeExponent": { "type": "number", "minimum": 0, "maximum": 1 },
        "shapeRange": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
        "landStep": { "type": "number", "minimum": 0 },
        "levelStep": { "type": "number", "minimum": 0 },
        "maxLevel": { "type": "integer", "minimum": 1 },
        "rarity": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } }
      }
    },
    "drops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinary", "elite", "champion", "guardian", "lower", "professionPerHour", "professionMax", "guild"],
      "description": "Szanse kart: pokonany stwór na wyprawie i w Labiryncie według rodzaju (guardian: strażnik Labiryntu), lower: wygrana walka wyprawy na kartę z niższej krainy (902 B), professionPerHour i professionMax: praca w profesji za godzinę i najwyżej, guild: atak na Bestię, walka ze strażnikiem Wyprawy Gildii i ukończona Próba (903).",
      "properties": {
        "ordinary": { "$ref": "#/definitions/chance" },
        "elite": { "$ref": "#/definitions/chance" },
        "champion": { "$ref": "#/definitions/chance" },
        "guardian": { "$ref": "#/definitions/chance" },
        "lower": { "$ref": "#/definitions/chance" },
        "professionPerHour": { "$ref": "#/definitions/chance" },
        "professionMax": { "$ref": "#/definitions/chance" },
        "guild": { "$ref": "#/definitions/chance" }
      }
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monsters"],
      "properties": { "monsters": { "type": "array", "items": { "$ref": "#/definitions/id" } } }
    },
    "heroes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "text", "power"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "kind": { "enum": ["fury", "aim", "shift", "revive", "swap"] },
          "name": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "plus": { "type": "string", "minLength": 1 },
          "power": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "stakes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "levelsPerStep", "perDay"],
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "levelsPerStep": { "type": "integer", "minimum": 1 },
        "perDay": { "type": "integer", "minimum": 1 }
      }
    },
    "pack": {
      "description": "Pakiet u Szczęsnego (902 C): raz dziennie `cards` kart stworów z krain niższych niż kraina postaci, za złoto `goldMinutes` minut wyprawy na poziomie postaci.",
      "type": "object",
      "additionalProperties": false,
      "required": ["cards", "goldMinutes"],
      "properties": {
        "cards": { "type": "integer", "minimum": 1 },
        "goldMinutes": { "type": "integer", "minimum": 1 }
      }
    },
    "live": {
      "description": "Partie na żywo z innymi graczami (901 B, src/engine/card-duel.js): wyzwanie czeka acceptSeconds sekund, ruch turnSeconds sekund (i graceSeconds zapasu), missedRounds rund z rzędu bez ruchu to przegrana; zwycięzca zgarnia obie stawki bez udziału systemCut; o złoto od minLevel poziomu obu postaci, najwyżej perDay partii o złoto dziennie; wyzwanie odrzucone albo przeterminowane do tej samej postaci znów po repeatSeconds sekundach.",
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptSeconds", "turnSeconds", "graceSeconds", "missedRounds", "systemCut", "perDay", "minLevel", "repeatSeconds"],
      "properties": {
        "$comment": { "type": "string" },
        "acceptSeconds": { "type": "integer", "minimum": 10 },
        "turnSeconds": { "type": "integer", "minimum": 5 },
        "graceSeconds": { "type": "integer", "minimum": 0 },
        "missedRounds": { "type": "integer", "minimum": 1 },
        "systemCut": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "perDay": { "type": "integer", "minimum": 1 },
        "minLevel": { "type": "integer", "minimum": 1 },
        "repeatSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "tiers"],
      "properties": {
        "resident": { "$ref": "#/definitions/id" },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "text", "stake", "rewardMinutes", "firstWin", "smart", "cards"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "name": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "stake": { "type": "integer", "minimum": 1 },
              "rewardMinutes": { "type": "integer", "minimum": 0 },
              "firstWin": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rarity"],
                "properties": { "rarity": { "$ref": "#/definitions/id" } }
              },
              "smart": { "type": "integer", "minimum": 0, "maximum": 2 },
              "cards": { "type": "array", "items": { "$ref": "#/definitions/card" } }
            }
          }
        }
      }
    },
    "residents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shown", "chance", "tables"],
      "description": "Partie z mieszkańcami Osady (904 B, src/engine/card-residents.js): każdy mieszkaniec gra u siebie własną talią, między stopniami Szczęsnego.",
      "properties": {
        "$comment": { "type": "string" },
        "shown": { "type": "integer", "minimum": 1, "description": "Ile pierwszych kart talii mieszkańca widać przy jego stole." },
        "chance": { "$ref": "#/definitions/chance", "description": "Szansa na kartę z talii mieszkańca przy każdej wygranej o stawkę po pierwszej." },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "after", "stake", "smart", "icon", "gender", "with", "of", "name", "style", "win", "loss", "draw", "cards"],
            "properties": {
              "id": { "$ref": "#/definitions/id", "description": "Mieszkaniec Osady (settlement.json, residents), który ma swoje miejsce." },
              "after": { "type": "integer", "minimum": 1, "description": "Stopień Szczęsnego, od którego talia jest mocniejsza; liczba stopni: mocniejsza od wszystkich." },
              "stake": { "type": "number", "exclusiveMinimum": 0, "description": "Stawka razy stawka podstawowa, między stawkami sąsiednich stopni." },
              "smart": { "type": "integer", "minimum": 0, "maximum": 2, "description": "Sposób gry, jak u Szczęsnego." },
              "icon": { "$ref": "#/definitions/id", "description": "Ikona talii (src/client/icons.js)." },
              "gender": { "enum": ["f", "m"], "description": "Rodzaj mieszkańca w słowach gry." },
              "with": { "type": "string", "minLength": 1, "description": "„z Jagną”: w tytule „Karty z Jagną”." },
              "of": { "type": "string", "minLength": 1, "description": "„Jagny”: w słowach „z talii Jagny”." },
              "name": { "type": "string", "minLength": 1, "description": "Nazwa talii." },
              "style": { "type": "string", "minLength": 1, "description": "Styl talii." },
              "win": { "$ref": "#/definitions/texts" },
              "loss": { "$ref": "#/definitions/texts" },
              "draw": { "$ref": "#/definitions/texts" },
              "cards": { "type": "array", "items": { "$ref": "#/definitions/card" } }
            }
          }
        }
      }
    },
    "bonuses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection"],
      "description": "Premia za kolekcję (884 A, src/engine/card-collection.js).",
      "properties": {
        "$comment": { "type": "string" },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["every", "xp", "gold", "max"],
          "description": "Co every różnych kart udział xp więcej XP i gold więcej złota z wypraw, każdy najwyżej max; 0 wyłącza premię.",
          "properties": {
            "every": { "type": "integer", "minimum": 1 },
            "xp": { "type": "number", "minimum": 0, "maximum": 1 },
            "gold": { "type": "number", "minimum": 0, "maximum": 1 },
            "max": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intro", "starterOffer", "starterTaken", "rules", "win", "loss", "draw", "drop", "lower", "guild", "trial", "pack", "live", "collection"],
      "properties": {
        "intro": { "type": "string", "minLength": 1 },
        "starterOffer": { "type": "string", "minLength": 1 },
        "starterTaken": { "type": "string", "minLength": 1 },
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offer", "opened"],
          "properties": { "offer": { "type": "string", "minLength": 1 }, "opened": { "type": "string", "minLength": 1 } }
        },
        "live": {
          "type": "object",
          "additionalProperties": false,
          "description": "Słowa partii na żywo (901 B, src/client/card-duel.js): {…} wypełnia gra, [a|b] to forma dla kobiety i dla mężczyzny.",
          "required": ["challengeTitle", "online", "staked", "free", "limits", "lowLevel", "rules", "sent", "incomingTitle", "incoming", "incomingStake", "incomingFree", "incomingGold", "accepted", "declined", "expired", "tableStaked", "tableFree", "dividerStaked", "dividerFree", "lead", "answer", "theirLead", "theirAnswer", "missedMe", "missedFoe", "yourMove", "ends"],
          "patternProperties": { "^(?!ends$)[a-zA-Z]+$": { "type": "string", "minLength": 1 } },
          "properties": {
            "ends": {
              "type": "object",
              "additionalProperties": false,
              "required": ["won", "lost", "drawn"],
              "properties": {
                "won": { "$ref": "#/definitions/endTexts" },
                "lost": { "$ref": "#/definitions/endTexts" },
                "drawn": { "$ref": "#/definitions/endTexts" }
              }
            }
          }
        },
        "rules": { "$ref": "#/definitions/texts" },
        "win": { "$ref": "#/definitions/texts" },
        "loss": { "$ref": "#/definitions/texts" },
        "draw": { "$ref": "#/definitions/texts" },
        "drop": { "$ref": "#/definitions/texts" },
        "lower": { "$ref": "#/definitions/texts", "description": "Zdanie raportu wyprawy o karcie z niższej krainy (902 B)." },
        "guild": { "$ref": "#/definitions/texts", "description": "Słowa po ataku na Bestię albo strażnika Wyprawy Gildii, gdy wpadła karta (903)." },
        "trial": { "$ref": "#/definitions/texts", "description": "Słowa przy karcie za ukończoną Próbę Gildii (903)." },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "description": "Słowa rubryki „Karty” w Encyklopedii i premii za kolekcję (src/engine/card-collection.js).",
          "required": ["summary", "note", "unknown", "land", "kinds", "meta", "type", "level", "copies", "copiesTop", "places", "chance", "bonusNow", "bonusNext", "bonusTop", "bonusRule", "report"],
          "properties": {
            "kinds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ordinary", "elite", "champion"],
              "properties": {
                "ordinary": { "type": "string", "minLength": 1 },
                "elite": { "type": "string", "minLength": 1 },
                "champion": { "type": "string", "minLength": 1 }
              }
            },
            "summary": { "$ref": "#/definitions/texts" },
            "note": { "$ref": "#/definitions/texts" },
            "unknown": { "$ref": "#/definitions/texts" },
            "land": { "$ref": "#/definitions/texts" },
            "meta": { "$ref": "#/definitions/texts" },
            "type": { "$ref": "#/definitions/texts" },
            "level": { "$ref": "#/definitions/texts" },
            "copies": { "$ref": "#/definitions/texts" },
            "copiesTop": { "$ref": "#/definitions/texts" },
            "places": { "$ref": "#/definitions/texts" },
            "chance": { "$ref": "#/definitions/texts" },
            "bonusRule": { "$ref": "#/definitions/texts" },
            "bonusNow": { "$ref": "#/definitions/texts" },
            "bonusNext": { "$ref": "#/definitions/texts" },
            "bonusTop": { "$ref": "#/definitions/texts" },
            "report": { "$ref": "#/definitions/texts" }
          }
        }
      }
    }
  }
}
