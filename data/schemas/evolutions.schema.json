{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ewolucje klas",
  "description": "Ewolucje klas na pierwszym poziomie z balance.progression.classEvolutionLevels: każda prowadzi jedną ścieżkę (path, umiejętność klasy), daje nazwę, przyrost statystyk od następnego poziomu klasy, cechę i dwie umiejętności. Umiejętności ewolucji biorą klasę i poziom z ewolucji, rosną do skillMaxLevel, a ich liczby to [poziom 1, poziom skillMaxLevel].",
  "type": "object",
  "additionalProperties": false,
  "required": ["skillMaxLevel", "lastPointClassLevel", "pointsPerClassLevel", "evolutions", "skills", "texts"],
  "properties": {
    "$comment": { "type": "string" },
    "skillMaxLevel": { "type": "integer", "minimum": 2 },
    "place": { "type": "string", "minLength": 1, "description": "Tło zakładki Ewolucja: źródło ze stołem ceremonialnym, obrazek z src/client/art/places." },
    "lastPointClassLevel": { "type": "integer", "minimum": 1, "description": "Ostatni poziom klasy, który daje Punkt Umiejętności po ewolucji." },
    "pointsPerClassLevel": { "type": "integer", "minimum": 1 },
    "evolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classId", "path", "name", "growth", "trait", "skills"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "classId": { "type": "string" },
          "path": { "type": "string", "description": "Umiejętność klasy, której ścieżkę prowadzi ewolucja." },
          "name": { "type": "string", "minLength": 1 },
          "growth": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }, "description": "Przyrost statystyk na poziom klasy po ewolucji, zamiast przyrostu klasy." },
          "perClassLevel": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hp", "mana"],
            "properties": { "hp": { "type": "number", "minimum": 0 }, "mana": { "type": "number", "minimum": 0 } },
            "description": "HP i mana na poziom klasy po ewolucji, zamiast klasy (brak: jak w klasie)."
          },
          "trait": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text", "kind", "params"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "params": { "type": "object" }
            }
          },
          "skills": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2, "description": "Pierwsza to rozwinięta umiejętność ścieżki (from), druga nowa." }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evolution", "name", "style", "description", "effect", "kind", "mana", "params"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "evolution": { "type": "string" },
          "from": { "type": "string", "description": "Umiejętność klasy, którą ta rozwija." },
          "name": { "type": "string", "minLength": 1 },
          "style": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["strike", "sweep", "heal", "guard", "buff", "coat", "shield", "evade", "stance", "riposte", "summon", "miracle", "mark", "whirl"] },
          "mana": { "type": "integer", "minimum": 0 },
          "cooldown": { "type": "integer", "minimum": 1 },
          "once": { "const": true },
          "params": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                { "type": "number" },
                { "type": "boolean" },
                { "type": "string" },
                { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
              ]
            }
          }
        }
      }
    },
    "texts": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
