{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gildie",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "found",
    "size",
    "name",
    "tag",
    "invites",
    "tabs",
    "trials",
    "requests",
    "exchange",
    "fame"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "place": {
      "description": "Obrazek z art/places za nagłówkiem strony Gildii (autor: 353 C, warowny dwór gildii na wzgórzu).",
      "type": "string"
    },
    "found": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "gold"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "size": {
      "type": "integer",
      "minimum": 2
    },
    "name": {
      "$ref": "#/definitions/range"
    },
    "tag": {
      "$ref": "#/definitions/range"
    },
    "invites": {
      "type": "integer",
      "minimum": 1
    },
    "tabs": {
      "description": "Zakładki strony Gildii (src/client/screens/guild.js), w tej kolejności.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "enum": [
              "guild",
              "beast",
              "trials",
              "requests",
              "exchange"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "beast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attacksPerDay",
        "memberAttacks",
        "damage",
        "chests",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "attacksPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "memberAttacks": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ]
          }
        },
        "chests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "share",
              "item",
              "materials"
            ],
            "properties": {
              "share": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "item": {
                "type": "boolean"
              },
              "materials": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "texts": {
          "type": "object",
          "required": [
            "title",
            "lead",
            "rules",
            "level",
            "attacksLeft",
            "newAttacks",
            "attackForms",
            "attack",
            "lastAttack",
            "fell",
            "fallen",
            "lastBlow",
            "until",
            "exploring",
            "claimFirst",
            "log",
            "contribution",
            "noHits",
            "own",
            "chestTitle",
            "chestFallen",
            "chestShare",
            "chestUntil",
            "open",
            "opened",
            "noGuild",
            "errors"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attackForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "fallen",
                "noAttacks",
                "raced",
                "noChest",
                "claimed",
                "bagFull"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trials": {
      "$ref": "#/definitions/trials"
    },
    "requests": {
      "$ref": "#/definitions/requests"
    },
    "exchange": {
      "$ref": "#/definitions/exchange"
    },
    "fame": {
      "$ref": "#/definitions/fame"
    }
  },
  "definitions": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pair": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "trialKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "counted",
        "weight"
      ],
      "oneOf": [
        {
          "required": [
            "count"
          ]
        },
        {
          "required": [
            "fights"
          ]
        }
      ],
      "properties": {
        "id": {
          "enum": [
            "killAny",
            "explore",
            "towers",
            "gatherAny",
            "brewAny",
            "makeAny",
            "process",
            "salvage",
            "orders",
            "upgrade",
            "gifts"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\{count\\}"
        },
        "counted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "enum": [
            "towers",
            "professions",
            "crafting",
            "table",
            "settlement",
            "anvil"
          ]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "count": {
          "$ref": "#/definitions/pair"
        },
        "fights": {
          "$ref": "#/definitions/pair"
        },
        "step": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "trialChest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "timePoints",
        "materials"
      ],
      "properties": {
        "gold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "perLevel"
          ],
          "properties": {
            "base": {
              "type": "number",
              "minimum": 0
            },
            "perLevel": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "timePoints": {
          "type": "integer",
          "minimum": 0
        },
        "materials": {
          "type": "integer",
          "minimum": 0
        },
        "systemPoints": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board",
        "cap",
        "activeDays",
        "steps",
        "sizes",
        "kinds",
        "locks",
        "chests",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "board": {
          "type": "integer",
          "minimum": 1
        },
        "cap": {
          "type": "integer",
          "minimum": 1
        },
        "activeDays": {
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factor",
              "weight"
            ],
            "properties": {
              "factor": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/trialKind"
          }
        },
        "locks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "towers",
            "professions",
            "crafting",
            "table",
            "settlement",
            "anvil",
            "off"
          ],
          "properties": {
            "towers": {
              "type": "string",
              "minLength": 1
            },
            "professions": {
              "type": "string",
              "minLength": 1
            },
            "crafting": {
              "type": "string",
              "minLength": 1
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "settlement": {
              "type": "string",
              "minLength": 1
            },
            "anvil": {
              "type": "string",
              "minLength": 1
            },
            "off": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "chests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/trialChest"
          }
        },
        "texts": {
          "type": "object",
          "required": [
            "title",
            "intro",
            "how",
            "bar",
            "points",
            "barValue",
            "threshold",
            "trialForms",
            "chest",
            "open",
            "claimed",
            "contribute",
            "taken",
            "progress",
            "progressValue",
            "noTaken",
            "drop",
            "dropTitle",
            "dropText",
            "board",
            "take",
            "done",
            "takenMark",
            "busy",
            "previous",
            "previousUntil",
            "members",
            "capped",
            "empty",
            "noGuild",
            "took",
            "dropped",
            "opened",
            "gold",
            "timePointForms",
            "systemPointForms",
            "errors"
          ],
          "properties": {
            "how": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "trialForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "timePointForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "systemPointForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "noTrial",
                "busy",
                "done",
                "notTaken",
                "tooLate",
                "noThreshold",
                "noBoard",
                "claimed",
                "notReached"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kinds",
        "most",
        "waitHours",
        "openHours",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "material",
              "herb",
              "potion"
            ]
          }
        },
        "most": {
          "type": "integer",
          "minimum": 1
        },
        "waitHours": {
          "type": "number",
          "minimum": 0
        },
        "openHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "texts": {
          "type": "object",
          "required": [
            "title",
            "intro",
            "how",
            "ask",
            "askLead",
            "askWaiting",
            "kindNames",
            "kindGroups",
            "goods",
            "count",
            "send",
            "noGoods",
            "mine",
            "states",
            "given",
            "noGifts",
            "thank",
            "thanked",
            "cancel",
            "cancelTitle",
            "cancelText",
            "waitNext",
            "others",
            "empty",
            "noGuild",
            "left",
            "have",
            "give",
            "giveCount",
            "sameAccount",
            "rankingTitle",
            "ranking",
            "rankingEmpty",
            "pieceForms",
            "thankForms",
            "asked",
            "gave",
            "thankedToast",
            "cancelled",
            "errors"
          ],
          "properties": {
            "how": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "kindNames": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material",
                "herb",
                "potion"
              ],
              "properties": {
                "material": {
                  "type": "string",
                  "minLength": 1
                },
                "herb": {
                  "type": "string",
                  "minLength": 1
                },
                "potion": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "states": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "open",
                "filled",
                "cancelled",
                "expired"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "minLength": 1
                },
                "filled": {
                  "type": "string",
                  "minLength": 1
                },
                "cancelled": {
                  "type": "string",
                  "minLength": 1
                },
                "expired": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "pieceForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "thankForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "invalidKind",
                "invalidGoods",
                "invalidCount",
                "open",
                "wait",
                "bagFull",
                "noRequest",
                "gone",
                "own",
                "closed",
                "sameAccount",
                "giveCount",
                "tooMany",
                "notEnough",
                "notHeld",
                "askerRoom",
                "askerFull",
                "changed",
                "noGift",
                "thanked"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "kindGroups": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "material",
                "herb",
                "potion"
              ],
              "properties": {
                "material": {
                  "type": "string",
                  "minLength": 1
                },
                "herb": {
                  "type": "string",
                  "minLength": 1
                },
                "potion": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exchange": {
      "description": "Wymiana zasobów w Gildii (src/server/guild-exchange.js, src/client/guild-exchange.js).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "most",
        "sameCount",
        "offers",
        "openHours",
        "closedShown",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "most": {
          "description": "Najwięcej sztuk po jednej stronie oferty.",
          "type": "integer",
          "minimum": 1
        },
        "sameCount": {
          "description": "Czy po obu stronach oferty musi być tyle samo sztuk.",
          "type": "boolean"
        },
        "offers": {
          "description": "Najwięcej otwartych ofert jednej postaci naraz.",
          "type": "integer",
          "minimum": 1
        },
        "openHours": {
          "description": "Ile godzin najdłużej wisi oferta.",
          "type": "integer",
          "minimum": 1
        },
        "closedShown": {
          "description": "Ile ostatnich zamkniętych ofert postać widzi pod swoimi.",
          "type": "integer",
          "minimum": 0
        },
        "texts": {
          "type": "object",
          "required": [
            "title",
            "intro",
            "how",
            "countsFree",
            "countsSame",
            "offerForms",
            "hourForms",
            "post",
            "postLead",
            "give",
            "want",
            "count",
            "have",
            "send",
            "full",
            "mine",
            "mineEmpty",
            "states",
            "withdraw",
            "withdrawTitle",
            "withdrawText",
            "others",
            "empty",
            "gives",
            "wants",
            "take",
            "takeTitle",
            "takeText",
            "short",
            "sameAccount",
            "noGuild",
            "posted",
            "took",
            "withdrawn",
            "errors"
          ],
          "properties": {
            "how": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "offerForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hourForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "states": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "open",
                "taken",
                "withdrawn",
                "expired"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "minLength": 1
                },
                "taken": {
                  "type": "string",
                  "minLength": 1
                },
                "withdrawn": {
                  "type": "string",
                  "minLength": 1
                },
                "expired": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "invalidResource",
                "sameResource",
                "invalidCount",
                "sameCount",
                "notEnough",
                "notHeld",
                "noOffer",
                "notOwn",
                "own",
                "closed",
                "sameAccount",
                "short",
                "changed"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fame": {
      "description": "Ranking gildii: Sława tygodnia (src/server/guild-fame.js, src/client/screens/ranking.js).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beast",
        "trials",
        "requests",
        "exchange",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "beast": {
          "description": "Bestia Gildii: Sława za każdy pełny 1% paska bestii tygodnia i za jej upadek.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "perPercent",
            "fell"
          ],
          "properties": {
            "perPercent": {
              "type": "integer",
              "minimum": 0
            },
            "fell": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "trials": {
          "description": "Próby Gildii: Sława za każdą próbę wykonaną w tygodniu; limit postaci to trials.cap Prób.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "perTrial"
          ],
          "properties": {
            "perTrial": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "requests": {
          "description": "Prośby Gildii: Sława za każdą daną sztukę, z jednej postaci najwyżej cap sztuk.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "perPiece",
            "cap"
          ],
          "properties": {
            "perPiece": {
              "type": "integer",
              "minimum": 0
            },
            "cap": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "exchange": {
          "description": "Wymiana: Sława za każdą wziętą ofertę, z jednej biorącej postaci najwyżej cap wymian.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "perExchange",
            "cap"
          ],
          "properties": {
            "perExchange": {
              "type": "integer",
              "minimum": 0
            },
            "cap": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tabs",
            "periods",
            "lead",
            "how",
            "pointForms",
            "columns",
            "own",
            "empty",
            "champion"
          ],
          "properties": {
            "tabs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "characters",
                "guilds"
              ],
              "properties": {
                "characters": {
                  "type": "string",
                  "minLength": 1
                },
                "guilds": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "periods": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "week",
                "all"
              ],
              "properties": {
                "week": {
