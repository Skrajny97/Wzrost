{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gildie",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "found",
    "size",
    "name",
    "tag",
    "invites",
    "tabs",
    "seat",
    "trials",
    "requests",
    "exchange",
    "fame"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "place": {
      "description": "Obrazek z art/places za nagłówkiem strony Gildii (autor: 353 C, warowny dwór gildii na wzgórzu).",
      "type": "string"
    },
    "found": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "gold"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "size": {
      "type": "integer",
      "minimum": 2
    },
    "name": {
      "$ref": "#/definitions/range"
    },
    "tag": {
      "$ref": "#/definitions/range"
    },
    "invites": {
      "type": "integer",
      "minimum": 1
    },
    "tabs": {
      "description": "Zakładki strony Gildii (src/client/screens/guild.js), w tej kolejności.",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "enum": [
              "guild",
              "seat",
              "beast",
              "trials",
              "requests",
              "exchange"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "beast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attacksPerDay",
        "memberAttacks",
        "damage",
        "chests",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "attacksPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "memberAttacks": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ]
          }
        },
        "chests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "share",
              "item",
              "materials"
            ],
            "properties": {
              "share": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "item": {
                "type": "boolean"
              },
              "materials": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "texts": {
          "type": "object",
          "required": [
            "title",
            "lead",
            "rules",
            "level",
            "attacksLeft",
            "newAttacks",
            "attackForms",
            "attack",
            "lastAttack",
            "fell",
            "fallen",
            "lastBlow",
            "until",
            "log",
            "contribution",
            "noHits",
            "own",
            "chestTitle",
            "chestFallen",
            "chestShare",
            "chestUntil",
            "open",
            "opened",
            "notInBag",
            "noGuild",
            "errors"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attackForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "fallen",
                "noAttacks",
                "raced",
                "noChest",
                "claimed",
                "bagFull"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "seat": {
      "$ref": "#/definitions/seat"
    },
    "trials": {
      "$ref": "#/definitions/trials"
    },
    "requests": {
      "$ref": "#/definitions/requests"
    },
    "exchange": {
      "$ref": "#/definitions/exchange"
    },
    "fame": {
      "$ref": "#/definitions/fame"
    }
  },
  "definitions": {
    "seat": {
      "description": "Siedziba Gildii (src/engine/guild-seat.js, src/server/guild-seat.js, src/client/guild-seat.js; autor: 616 A).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLevel",
        "cost",
        "quick",
        "buildings",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "maxLevel": {
          "description": "Najwyższy poziom każdego budynku.",
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "description": "Koszt poziomu n: max(min, perLevel × n) złota i tyle samo liczony zasób budynku.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gold",
            "resource"
          ],
          "properties": {
            "gold": {
              "$ref": "#/definitions/seatCost"
            },
            "resource": {
              "$ref": "#/definitions/seatCost"
            }
          }
        },
        "quick": {
          "description": "Szybkie kwoty złota i zasobu w formularzu wpłaty.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gold",
            "resource"
          ],
          "properties": {
            "gold": {
              "$ref": "#/definitions/seatQuick"
            },
            "resource": {
              "$ref": "#/definitions/seatQuick"
            }
          }
        },
        "buildings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "accusative",
              "resource",
              "bonus",
              "perLevel",
              "effect"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z]+(-[a-z]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "accusative": {
                "description": "Nazwa w bierniku: „Wpłacić na Kuźnię Gildii?”.",
                "type": "string",
                "minLength": 1
              },
              "resource": {
                "description": "Zasób obozu, który budynek bierze obok złota (id z data/resources.json).",
                "type": "string",
                "minLength": 1
              },
              "bonus": {
                "description": "Premia budynku dla członków: xp (XP z walk wypraw), gold (złoto z walk i znalezisk wypraw), anvil (upust złota na Kowadle), rarity (rzadsze przedmioty z wypraw).",
                "enum": [
                  "xp",
                  "gold",
                  "anvil",
                  "rarity"
                ]
              },
              "perLevel": {
                "description": "Premia za każdy poziom, jako ułamek (0.01 to 1%).",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 0.1
              },
              "effect": {
                "type": "string",
                "pattern": "\\{value\\}"
              }
            }
          }
        },
        "texts": {
          "type": "object",
          "required": [
            "title",
            "intro",
            "how",
            "bonuses",
            "noBonuses",
            "level",
            "now",
            "next",
            "none",
            "raising",
            "collected",
            "surplus",
            "top",
            "preferred",
            "prefer",
            "unprefer",
            "preferredOn",
            "preferredOff",
            "donation",
            "gold",
            "have",
            "rest",
            "donate",
            "donateTitle",
            "donateText",
            "goldAmount",
            "goldGenitive",
            "enough",
            "resourceAmount",
            "both",
            "donated",
            "raised",
            "noGuild",
            "errors"
          ],
          "properties": {
            "how": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "noBuilding",
                "invalidAmount",
                "nothing",
                "notEnough",
                "top",
                "tooMuch",
                "notAllowed",
                "invalidMark",
                "changed"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "seatCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "perLevel"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "perLevel": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "seatQuick": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pair": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "trialKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "counted",
        "weight"
      ],
      "oneOf": [
        {
          "required": [
            "count"
          ]
        },
        {
          "required": [
            "fights"
          ]
        }
      ],
      "properties": {
        "id": {
          "enum": [
            "killAny",
            "explore",
            "towers",
            "gatherAny",
            "brewAny",
            "makeAny",
            "process",
            "salvage",
            "orders",
            "upgrade",
            "gifts"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\{count\\}"
        },
        "counted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "enum": [
            "towers",
            "professions",
            "crafting",
            "table",
            "settlement",
            "anvil"
          ]
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "count": {
          "$ref": "#/definitions/pair"
        },
        "fights": {
          "$ref": "#/definitions/pair"
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "levelsBelow": {
          "type": "integer",
          "minimum": 0,
          "description": "Wygrana w Wieży liczy się tylko na piętrze najwyżej tyle poziomów poniżej poziomu postaci (autor: 488 A)."
        }
      }
    },
    "trialChest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "timePoints",
        "materials"
      ],
      "properties": {
        "gold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "perLevel"
          ],
          "properties": {
            "base": {
              "type": "number",
              "minimum": 0
            },
            "perLevel": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "timePoints": {
          "type": "integer",
          "minimum": 0
        },
        "materials": {
          "type": "integer",
          "minimum": 0
        },
        "systemPoints": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board",
        "cap",
        "activeDays",
        "steps",
        "sizes",
        "kinds",
        "locks",
        "chests",
        "texts"
