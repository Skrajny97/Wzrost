{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gildie",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "found",
    "size",
    "name",
    "tag",
    "invites"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "place": {
      "description": "Obrazek z art/places za nagłówkiem strony Gildii (autor: 353 C, warowny dwór gildii na wzgórzu).",
      "type": "string"
    },
    "found": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "gold"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "size": {
      "type": "integer",
      "minimum": 2
    },
    "name": {
      "$ref": "#/definitions/range"
    },
    "tag": {
      "$ref": "#/definitions/range"
    },
    "invites": {
      "type": "integer",
      "minimum": 1
    },
    "beast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attacksPerDay",
        "memberAttacks",
        "damage",
        "chests",
        "texts"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "attacksPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "memberAttacks": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "damage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ]
          }
        },
        "chests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "share",
              "item",
              "materials"
            ],
            "properties": {
              "share": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "item": {
                "type": "boolean"
              },
              "materials": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "texts": {
          "type": "object",
          "required": [
            "title",
            "lead",
            "rules",
            "level",
            "attacksLeft",
            "newAttacks",
            "attackForms",
            "attack",
            "lastAttack",
            "fell",
            "fallen",
            "lastBlow",
            "until",
            "exploring",
            "claimFirst",
            "log",
            "contribution",
            "noHits",
            "own",
            "chestTitle",
            "chestFallen",
            "chestShare",
            "chestUntil",
            "open",
            "opened",
            "noGuild",
            "errors"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attackForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "fallen",
                "noAttacks",
                "raced",
                "noChest",
                "claimed",
                "bagFull"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
