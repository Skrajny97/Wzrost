            "opened",
            "gold",
            "timePointForms",
            "systemPointForms",
            "errors"
          ],
          "properties": {
            "how": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "trialForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
