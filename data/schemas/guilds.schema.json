            "systemPointForms": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "errors": {
              "type": "object",
              "required": [
                "locked",
                "noGuild",
                "tooLate",
                "noThreshold",
                "noBoard",
                "claimed",
                "notReached"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
