{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Efekty okresowe",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "element"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "element": { "type": "string" }
    }
  }
}
