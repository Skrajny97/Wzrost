{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Efekty okresowe",
  "description": "color: kolor napisu efektu i liczb traconego przez niego HP w odtwarzaniu walki.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "element", "color"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "element": { "type": "string" },
      "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
    }
  }
}
