{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osada",
  "description": "Osada, część I: plansza z miejscami, stali mieszkańcy, bractwa i stopnie reputacji, Tablica zleceń, Zaklinaczka i Pustelnik (src/engine/settlement.js).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "places", "residents", "brotherhoods", "standings", "orders", "reforge", "hermit"],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "goodKind": { "enum": ["herb", "potion", "material", "resource", "part", "craft"] },
    "perKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["herb", "potion", "material", "resource", "part", "craft"],
      "properties": {
        "herb": { "$ref": "#/definitions/kindValue" },
        "potion": { "$ref": "#/definitions/kindValue" },
        "material": { "$ref": "#/definitions/kindValue" },
        "resource": { "$ref": "#/definitions/kindValue" },
        "part": { "$ref": "#/definitions/kindValue" },
        "craft": { "$ref": "#/definitions/kindValue" }
      }
    },
    "kindValue": {}
  },
  "properties": {
    "$comment": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "x", "y"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "x": { "type": "number", "minimum": 0, "maximum": 100 },
          "y": { "type": "number", "minimum": 0, "maximum": 100 },
          "resident": { "$ref": "#/definitions/id" },
          "soon": { "type": "boolean", "description": "Miejsce widać na planszy, ale otwiera się w kolejnej części." }
        }
      }
    },
    "torches": {
      "type": "array",
      "description": "Pochodnie na planszy, które migoczą jak ognisko w obozie: miejsce podstawy pochodni w procentach planszy.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "maximum": 100 },
          "y": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "residents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "title", "story", "greetings"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "story": { "type": "string", "minLength": 1, "description": "Kilka zdań o mieszkańcu, w brzmieniu autora (pytania 159–163)." },
          "greetings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Powitanie na każdym stopniu relacji, po kolei; ostatnie zostaje na wyższych." }
        }
      }
    },
    "brotherhoods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "goods"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "goods": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/goodKind" } }
        }
      }
    },
    "standings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "points"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "points": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "orders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "open", "refillMinutes", "expireDays", "reputation", "relationGain", "weekly", "pay", "resourceGold", "partGold", "overScrap", "partRarity", "counts", "quality", "special", "systemPoints", "stories", "craftStories"],
      "properties": {
        "open": { "type": "integer", "minimum": 1 },
        "refillMinutes": { "type": "integer", "minimum": 1 },
        "expireDays": { "type": "integer", "minimum": 1, "description": "Ile dni zlecenie wisi na tablicy, zanim w jego miejsce przyjdzie nowe." },
        "reputation": { "type": "integer", "minimum": 1 },
        "resident": { "type": "string", "description": "Mieszkaniec, który wiesza zlecenia; relationGain to przyrost relacji z nim." },
        "relationGain": { "type": "integer", "minimum": 0 },
        "weekly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "reward", "reputation"],
          "properties": {
            "count": { "type": "number", "minimum": 1 },
            "reward": { "type": "number", "minimum": 1 },
            "reputation": { "type": "integer", "minimum": 1 }
          }
        },
        "pay": {
          "allOf": [{ "$ref": "#/definitions/perKind" }],
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "resourceGold": { "type": "number", "exclusiveMinimum": 0 },
        "partGold": { "type": "number", "exclusiveMinimum": 0 },
        "overScrap": { "type": "number", "minimum": 1, "description": "Za zioła, mikstury i materiały zlecenie płaci co najmniej tyle razy więcej, niż daje złomiarz postaci." },
        "partRarity": { "$ref": "#/definitions/id" },
        "counts": {
          "allOf": [{ "$ref": "#/definitions/perKind" }],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "perTenLevels"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 },
              "perTenLevels": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "chance", "reward"],
          "properties": {
            "from": { "$ref": "#/definitions/id" },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 },
            "reward": { "type": "number", "minimum": 1 }
          }
        },
        "special": {
          "type": "object",
          "description": "Zlecenia specjalne od stopnia from: chance zleceń bractwa daje reputation razy więcej reputacji i systemPoints Punktów Systemu, przy tej samej zapłacie.",
          "additionalProperties": false,
          "required": ["from", "chance", "reputation", "systemPoints"],
          "properties": {
            "from": { "$ref": "#/definitions/id" },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 },
            "reputation": { "type": "number", "minimum": 1 },
            "systemPoints": { "type": "integer", "minimum": 0 }
          }
        },
        "systemPoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["every", "points", "weekly"],
          "properties": {
            "every": { "type": "integer", "minimum": 1 },
            "points": { "type": "integer", "minimum": 0 },
            "weekly": { "type": "integer", "minimum": 0 }
          }
        },
        "stories": {
          "allOf": [{ "$ref": "#/definitions/perKind" }],
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "craftStories": {
          "type": "array",
          "description": "Zdania zleceń na wyroby Warsztatu, które pasują tylko do przedmiotów z tych miejsc (slots), obok ogólnych z stories.craft.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slots", "text"],
            "properties": {
              "slots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reforge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "goldPerLevel", "growth", "materials", "relationGain", "choices"],
      "properties": {
        "goldPerLevel": { "type": "number", "exclusiveMinimum": 0 },
        "choices": {
          "type": "array",
          "description": "Od którego stopnia relacji z Zaklinaczką zaklęcie daje do wyboru więcej nowych afiksów (count); niżej jeden.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "count"],
            "properties": {
              "from": { "$ref": "#/definitions/id" },
              "count": { "type": "integer", "minimum": 2 }
            }
          }
        },
        "growth": { "type": "number", "minimum": 1 },
        "materials": {
          "type": "object",
          "description": "Według rzadkości przedmiotu: rzadkość i liczba sztuk materiału stworów.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rarity", "count"],
            "properties": {
              "rarity": { "$ref": "#/definitions/id" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "resident": { "type": "string", "description": "Mieszkaniec tej usługi; relationGain to przyrost relacji z nim." },
        "relationGain": { "type": "integer", "minimum": 0 }
      }
    },
    "hermit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "pathGoldPerLevel", "evolutionGold", "evolutionGrowth", "statsFromLevel", "statsGoldPerLevel", "relationGain"],
      "properties": {
        "pathGoldPerLevel": { "type": "number", "exclusiveMinimum": 0 },
        "evolutionGold": { "type": "integer", "minimum": 1 },
        "evolutionGrowth": { "type": "number", "minimum": 1 },
        "statsFromLevel": { "type": "integer", "minimum": 1 },
        "statsGoldPerLevel": { "type": "number", "exclusiveMinimum": 0 },
        "resident": { "type": "string", "description": "Mieszkaniec tej usługi; relationGain to przyrost relacji z nim." },
        "relationGain": { "type": "integer", "minimum": 0 }
      }
    },
    "tavern": { "type": "object", "additionalProperties": false, "required": ["resident", "relationGain", "mugGoldPerLevel", "rumor"], "properties": { "resident": { "type": "string", "description": "Karczmarz: id mieszkańca, przy którym rośnie relacja o relationGain za kufel." }, "relationGain": { "type": "integer", "minimum": 0 }, "mugGoldPerLevel": { "type": "number", "exclusiveMinimum": 0 }, "rumor": { "type": "object", "additionalProperties": false, "required": ["factor", "newest", "lines"], "properties": { "factor": { "type": "number", "minimum": 1 }, "newest": { "type": "integer", "minimum": 1 }, "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } } },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hours", "fee", "offers", "brotherhood", "minRaise", "maxPrice", "kinds", "reputation", "merchant", "wanderer", "testSeller", "testMinutes", "resident"],
      "description": "Targowisko (część III, pytania 237–242): oferty graczy jak aukcje i oferty mieszkańców (src/engine/market.js). Oferta trwa hours godzin, z ceną wywoławczą i opcjonalną ceną „Kup teraz”. Targowisko bierze fee ceny sprzedaży. Postać ma naraz offers ofert i jedną więcej na każdy stopień reputacji bractwa brotherhood ponad pierwszy. Kolejna oferta w licytacji to co najmniej minRaise więcej, nie mniej niż złoto więcej. Ceny do maxPrice. kinds: co da się wystawić. reputation: punkt reputacji bractwa za każde goldPerPointPerLevel złota razy poziom postaci z handlu, najwyżej daily dziennie. merchant: kupiec codziennie sprzedaje goods sztuk rodzajów (zioła, materiały rzadkości materialRarities, części rzadkości partRarities) po cenie margin razy więcej niż najwyższa cena skupu u NPC, razy wahanie dnia z zakresu swing; postać kupi dziennie do stock sztuk każdego. wanderer: raz w tygodniu, na dobę, wędrowny handlarz ma items przedmiotów na poziom postaci, rzadkości losowanych z wagami rarities, po cenie priceFactor razy tyle, ile płaci złomiarz. testSeller i testMinutes: na wersji testowej „Testuj Osadę” wystawia próbne oferty od tego handlarza, na tyle minut.",
      "properties": {
        "hours": { "type": "number", "exclusiveMinimum": 0 },
        "fee": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "offers": { "type": "integer", "minimum": 1 },
        "brotherhood": { "type": "string" },
        "minRaise": { "type": "number", "minimum": 0 },
        "maxPrice": { "type": "integer", "minimum": 1 },
        "testSeller": { "type": "string", "minLength": 1 },
        "resident": { "type": "string", "minLength": 1, "description": "Kupiec Targowiska: id mieszkańca. Zakupy u kupca dają relację z nim, tyle samo punktów co reputacji." },
        "testMinutes": { "type": "integer", "minimum": 1 },
        "kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["item", "herb", "potion", "material", "part"] } },
        "reputation": { "type": "object", "additionalProperties": false, "required": ["goldPerPointPerLevel", "daily"], "properties": { "goldPerPointPerLevel": { "type": "number", "exclusiveMinimum": 0 }, "daily": { "type": "integer", "minimum": 0 } } },
        "merchant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goods", "materialRarities", "partRarities", "margin", "swing", "stock"],
          "properties": {
            "goods": { "type": "object", "additionalProperties": false, "required": ["herb", "material", "part"], "properties": { "herb": { "type": "integer", "minimum": 0 }, "material": { "type": "integer", "minimum": 0 }, "part": { "type": "integer", "minimum": 0 } } },
            "materialRarities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "partRarities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "margin": { "type": "number", "exclusiveMinimum": 1 },
            "swing": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
            "stock": { "type": "integer", "minimum": 1 }
          }
        },
        "wanderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items", "rarities", "priceFactor"],
          "properties": {
            "items": { "type": "integer", "minimum": 1 },
            "rarities": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
            "priceFactor": { "type": "number", "exclusiveMinimum": 1 }
          }
        }
      }
    },
    "companions": { "type": "object", "additionalProperties": false, "required": ["priceByStanding", "candidates", "levelSpread", "goldPerLevel", "xpShare", "catchUp", "skillStep", "thirdTraitChance", "xpCost", "names", "traits", "professions", "gifts", "stories"], "properties": { "priceByStanding": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }, "description": "Mnożnik ceny werbunku przy każdym stopniu relacji z karczmarzem (id stopnia: mnożnik). Werbunek działa przy każdym stopniu; im wyższy stopień, tym taniej." }, "candidates": { "type": "integer", "minimum": 1 }, "levelSpread": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } }, "goldPerLevel": { "type": "number", "minimum": 0 }, "xpShare": { "type": "number", "minimum": 0 }, "catchUp": { "type": "number", "minimum": 0 }, "skillStep": { "type": "integer", "minimum": 1 }, "thirdTraitChance": { "type": "number", "minimum": 0, "maximum": 1 }, "xpCost": { "type": "number", "minimum": 0, "maximum": 1 }, "names": { "type": "object", "additionalProperties": false, "required": ["female", "male"], "properties": { "female": { "type": "array", "minItems": 4, "items": { "type": "string" } }, "male": { "type": "array", "minItems": 4, "items": { "type": "string" } } } }, "traits": { "type": "array", "minItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["id", "names", "text"], "properties": { "id": { "type": "string" }, "names": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }, "text": { "type": "string" }, "damage": { "type": "number" }, "armor": { "type": "number" }, "hp": { "type": "number" }, "dodge": { "type": "number" }, "crit": { "type": "number" }, "speed": { "type": "number" }, "will": { "type": "number" } } } }, "professions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "goods"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "goods": { "type": "string", "enum": ["herb", "potion", "part"] } } } }, "gifts": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["min", "max", "perTenLevels"], "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 }, "perTenLevels": { "type": "number", "minimum": 0 } } } }, "stories": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "imbue": { "type": "object", "additionalProperties": false, "required": ["resident", "relationGain", "goldPerLevel", "materialCount", "weaponShare", "resistRarity", "slots", "elements"], "properties": { "resident": { "type": "string", "description": "Zaklinaczka: id mieszkańca, przy którym rośnie relacja za zaklęcie." }, "relationGain": { "type": "integer", "minimum": 0 }, "goldPerLevel": { "type": "number", "minimum": 0 }, "materialCount": { "type": "integer", "minimum": 0 }, "weaponShare": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "resistRarity": { "type": "string" }, "slots": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "elements": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["element", "material"], "properties": { "element": { "type": "string" }, "material": { "type": "string" } } } } } },
    "herbalist": { "type": "object", "additionalProperties": false, "required": ["resident", "brotherhood", "premium", "reputation"], "properties": { "resident": { "type": "string", "description": "Zielarka: id mieszkańca, przy którym rośnie relacja za handel." }, "brotherhood": { "type": "string", "description": "Bractwo, u którego rośnie reputacja za handel." }, "premium": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 }, "description": "O ile więcej niż złomiarz płaci zielarka, według stopnia relacji z nią." }, "reputation": { "type": "object", "additionalProperties": false, "required": ["goldPerPointPerLevel", "daily"], "properties": { "goldPerPointPerLevel": { "type": "number", "exclusiveMinimum": 0 }, "daily": { "type": "integer", "minimum": 0 } } } } }
  }
}
