{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osada",
  "description": "Osada, część I: plansza z miejscami, stali mieszkańcy, bractwa i stopnie reputacji, Tablica zleceń, Zaklinaczka i Pustelnik (src/engine/settlement.js).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "places", "residents", "brotherhoods", "standings", "relationDiscount", "orders", "reforge", "hermit"],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "goodKind": { "enum": ["herb", "potion", "material", "resource", "part", "craft"] },
    "perKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["herb", "potion", "material", "resource", "part", "craft"],
      "properties": {
        "herb": { "$ref": "#/definitions/kindValue" },
        "potion": { "$ref": "#/definitions/kindValue" },
        "material": { "$ref": "#/definitions/kindValue" },
        "resource": { "$ref": "#/definitions/kindValue" },
        "part": { "$ref": "#/definitions/kindValue" },
        "craft": { "$ref": "#/definitions/kindValue" }
      }
    },
    "kindValue": {}
  },
  "properties": {
    "$comment": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "x", "y"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "x": { "type": "number", "minimum": 0, "maximum": 100 },
          "y": { "type": "number", "minimum": 0, "maximum": 100 },
          "resident": { "$ref": "#/definitions/id" },
          "backdrop": { "$ref": "#/definitions/id", "description": "Wnętrze miejsca (src/client/art/places), przygaszone za kartą mieszkańca, tak jak miejsca profesji za swoimi kartami." },
          "soon": { "type": "boolean", "description": "Miejsce widać na planszy, ale otwiera się w kolejnej części." },
          "flip": { "type": "boolean", "description": "Obrazek budynku odbity w poziomie, żeby wejściem patrzył na główną drogę (autor: „zrób też rotate/odbicia lustrzane budynków tak by byly skierowane ich obrazki w stronę drogi głównej”)." }
        }
      }
    },
    "torches": {
      "type": "array",
      "description": "Pochodnie na planszy, które migoczą jak ognisko w obozie: miejsce podstawy pochodni w procentach planszy.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "maximum": 100 },
          "y": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "residents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "title", "story", "greetings"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "story": { "type": "string", "minLength": 1, "description": "Kilka zdań o mieszkańcu, w brzmieniu autora (pytania 159–163)." },
          "greetings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Powitanie na każdym stopniu relacji, po kolei; ostatnie zostaje na wyższych." }
        }
      }
    },
    "brotherhoods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "goods"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "goods": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/goodKind" } }
        }
      }
    },
    "standings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "points"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "points": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "orders": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "open", "refillMinutes", "expireDays", "reputation", "relationGain", "weekly", "pay", "resourceGold", "partGold", "overScrap", "partRarity", "materialStep", "anyMaterial", "counts", "quality", "special", "systemPoints", "stories", "craftStories"],
      "properties": {
        "open": { "type": "integer", "minimum": 1 },
        "refillMinutes": { "type": "integer", "minimum": 1 },
        "expireDays": { "type": "integer", "minimum": 1, "description": "Ile dni zlecenie wisi na tablicy, zanim w jego miejsce przyjdzie nowe." },
        "reputation": { "type": "integer", "minimum": 1 },
        "resident": { "type": "string", "description": "Mieszkaniec, który wiesza zlecenia; relationGain to przyrost relacji z nim." },
        "relationGain": { "type": "integer", "minimum": 0 },
        "weekly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "reward", "reputation"],
          "properties": {
            "count": { "type": "number", "minimum": 1 },
            "reward": { "type": "number", "minimum": 1 },
            "reputation": { "type": "integer", "minimum": 1 }
          }
        },
        "pay": {
          "allOf": [{ "$ref": "#/definitions/perKind" }],
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "resourceGold": { "type": "number", "exclusiveMinimum": 0 },
        "partGold": { "type": "number", "exclusiveMinimum": 0 },
        "overScrap": { "type": "number", "minimum": 1, "description": "Za zioła, mikstury i materiały zlecenie płaci co najmniej tyle razy więcej, niż daje złomiarz postaci." },
        "partRarity": { "$ref": "#/definitions/id" },
        "materialStep": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Zlecenie na dowolne materiały danej rzadkości: co rzadkość ponad pospolitą tyle razy mniej sztuk (0,5: o połowę mniej)." },
        "anyMaterial": {
          "type": "object",
          "description": "Nazwa dowolnego materiału danej rzadkości (klucz: id rzadkości) w trzech formach: jeden, dwa, pięć.",
          "additionalProperties": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } }
        },
        "counts": {
          "allOf": [{ "$ref": "#/definitions/perKind" }],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "perTenLevels"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 },
              "perTenLevels": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "chance", "reward"],
          "properties": {
            "from": { "$ref": "#/definitions/id" },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 },
            "reward": { "type": "number", "minimum": 1 }
          }
        },
        "special": {
          "type": "object",
          "description": "Zlecenia specjalne od stopnia from: chance zleceń bractwa daje reputation razy więcej reputacji i systemPoints Punktów Systemu, przy tej samej zapłacie.",
          "additionalProperties": false,
          "required": ["from", "chance", "reputation", "systemPoints"],
          "properties": {
            "from": { "$ref": "#/definitions/id" },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 },
            "reputation": { "type": "number", "minimum": 1 },
            "systemPoints": { "type": "integer", "minimum": 0 }
          }
        },
        "systemPoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["every", "points", "weekly"],
          "properties": {
            "every": { "type": "integer", "minimum": 1 },
            "points": { "type": "integer", "minimum": 0 },
            "weekly": { "type": "integer", "minimum": 0 }
          }
        },
        "stories": {
          "allOf": [{ "$ref": "#/definitions/perKind" }],
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "craftStories": {
          "type": "array",
          "description": "Zdania zleceń na wyroby Warsztatu, które pasują tylko do przedmiotów z tych miejsc (slots), obok ogólnych z stories.craft.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slots", "text"],
            "properties": {
              "slots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reforge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "goldPerLevel", "growth", "materials", "relationGain", "choices"],
      "properties": {
        "goldPerLevel": { "type": "number", "exclusiveMinimum": 0 },
        "choices": {
          "type": "array",
          "description": "Od którego stopnia relacji z Zaklinaczką zaklęcie daje do wyboru więcej nowych afiksów (count); niżej jeden.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "count"],
            "properties": {
              "from": { "$ref": "#/definitions/id" },
              "count": { "type": "integer", "minimum": 2 }
            }
          }
        },
        "growth": { "type": "number", "minimum": 1 },
        "materials": {
          "type": "object",
          "description": "Według rzadkości przedmiotu: rzadkość i liczba sztuk materiałów stworów; różne materiały tej rzadkości się sumują (481 B).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rarity", "count"],
            "properties": {
              "rarity": { "$ref": "#/definitions/id" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "resident": { "type": "string", "description": "Mieszkaniec tej usługi; relationGain to przyrost relacji z nim." },
        "relationGain": { "type": "integer", "minimum": 0 }
      }
    },
    "hermit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resident", "pathGoldPerLevel", "evolutionGold", "evolutionGrowth", "statsFromLevel", "statsGoldPerLevel", "relationGain"],
      "properties": {
        "pathGoldPerLevel": { "type": "number", "exclusiveMinimum": 0 },
        "evolutionGold": { "type": "integer", "minimum": 1 },
        "evolutionGrowth": { "type": "number", "minimum": 1 },
        "statsFromLevel": { "type": "integer", "minimum": 1 },
        "statsGoldPerLevel": { "type": "number", "exclusiveMinimum": 0 },
        "resident": { "type": "string", "description": "Mieszkaniec tej usługi; relationGain to przyrost relacji z nim." },
        "relationGain": { "type": "integer", "minimum": 0 }
      }
    },
    "stable": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stajnia (327 A; src/engine/stable.js): koniuszy (resident, id mieszkańca) sprzedaje wierzchowce na stałe, po kolei, a wyższy stopień zastępuje niższy. Każdy kupiony daje relationGain punktów relacji z nim. Wierzchowiec skraca czekanie na koniec każdej wyprawy postaci o shorter (0,05 to 5%: godzinna trwa 57 minut), poza Szybkim i Błyskawicznym Polowaniem; nagrody, doświadczenie i minuty raportu zostają jak za wybrany czas.",
      "required": ["resident", "relationGain", "mounts"],
      "properties": {
        "resident": { "type": "string", "description": "Koniuszy: id mieszkańca, przy którym rośnie relacja o relationGain za każdy kupiony wierzchowiec." },
        "relationGain": { "type": "integer", "minimum": 0 },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "description": "Stopnie wierzchowca, od pierwszego; postać trzyma numer stopnia (mount w characters.settlement).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "description", "shorter", "gold", "level"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z-]*$", "description": "Id grafik wierzchowca: obrazek w Stajni (art/mounts/<id>.png) i kłus w scenie Walki (art/mounts/<id>-trot.png)." },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "shorter": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "O jaką część krócej czeka się na koniec wyprawy." },
              "gold": { "type": "integer", "minimum": 1, "description": "Cena w złocie." },
              "level": { "type": "integer", "minimum": 1, "description": "Od którego poziomu postaci można go kupić." }
            }
          }
        }
      }
    },
    "casino": {
      "type": "object",
      "additionalProperties": false,
      "description": "Salon Gier (prośba autora z 3.11.2026, odpowiedzi 523–526; src/engine/casino.js): gospodarz (resident) prowadzi Loterię (lottery) i Koło Fortuny (wheel). Opis zasad w $comment bloku w data/settlement.json.",
      "required": ["resident", "relationGain", "lottery", "wheel", "texts"],
      "properties": {
        "$comment": { "type": "string" },
        "resident": { "type": "string", "description": "Gospodarz Salonu: id mieszkańca, przy którym rośnie relacja o relationGain za każdy los Loterii." },
        "relationGain": { "type": "integer", "minimum": 0 },
        "lottery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "ticket", "base"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "ticket": { "type": "integer", "minimum": 1, "description": "Cena losu w złocie; cała trafia do puli." },
            "base": { "type": "integer", "minimum": 0, "description": "Złoto od Systemu w puli, gdy dzień ma choć jeden los." }
          }
        },
        "wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "step", "maxSteps", "chance", "worthCap", "prizes", "itemChance", "itemRarity", "topItemRarity", "materialRarities"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "step": { "type": "integer", "minimum": 1, "description": "Najniższa stawka w złocie i krok, o który rośnie (542 C: 100 zł, setkami)." },
            "maxSteps": { "type": "integer", "minimum": 1, "description": "Najwyższa stawka to najwyżej tyle kroków." },
            "chance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Szansa wygranej, taka sama przy każdej stawce (od 0.1.13 10%; autor: „Koło fortuny proszę znerfić mocno i dać 10% szans”)." },
            "worthCap": { "type": "number", "exclusiveMinimum": 1, "description": "Nagroda jest warta najwyżej tyle stawek (2, jak przy dawnej szansie 50%), więc niższa szansa nie podnosi nagród. Nie więcej niż 1 / chance, żeby Koło nie oddawało średnio więcej, niż bierze." },
            "prizes": { "type": "integer", "minimum": 1, "description": "Ile nagród ma pula postaci na dobę przy każdej stawce." },
            "itemChance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Szansa, że nagroda jest przedmiotem, gdy jakiś przedmiot się mieści." },
            "itemRarity": { "type": "string", "description": "Najniższa rzadkość przedmiotu w puli." },
            "topItemRarity": { "type": "string", "description": "Najwyższa rzadkość przedmiotu w puli; najwyższa stawka to ta, przy której pasuje jeszcze przedmiot tej rzadkości." },
            "materialRarities": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }, "description": "Rzadkości materiałów w puli z wagami losowania." }
          }
        },
        "show": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wheel", "lottery", "sounds"],
          "description": "Gry Salonu na ekranie: Koło Fortuny kręcące się pod strzałką i los wpadający do bębna Loterii.",
          "properties": {
            "$comment": { "type": "string" },
            "wheel": {
              "type": "object",
              "additionalProperties": false,
              "required": ["art", "pointer", "wedges", "winAt", "pivot", "turns", "seconds"],
              "properties": {
                "art": { "type": "string" },
                "pointer": { "type": "string" },
                "wedges": { "type": "integer", "minimum": 2, "multipleOf": 2, "description": "Ile równych klinów ma koło; wygrana i przegrana na zmianę." },
                "winAt": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "description": "Środek pierwszego klinu wygranej w stopniach od góry obrazka, zgodnie ze wskazówkami zegara." },
                "pivot": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2, "description": "Środek koła w pikselach obrazka." },
                "turns": { "type": "integer", "minimum": 1 },
                "seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
              }
            },
            "lottery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["drum", "ticket", "seconds"],
              "properties": {
                "drum": { "type": "string" },
                "ticket": { "type": "string" },
                "seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 }
              }
            },
            "sounds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["spin", "win", "lose", "ticket"],
              "properties": { "spin": { "type": "string" }, "win": { "type": "string" }, "lose": { "type": "string" }, "ticket": { "type": "string" } }
            }
          }
        },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lotteryAbout", "lotteryToday", "lotteryBuy", "lotteryHas", "lotteryBought", "lotteryYesterday", "lotteryEarlier", "lotteryMine", "lotteryNone", "lotteryPlayers", "announce", "wheelAbout", "wheelPool", "wheelPoolAbout", "wheelStake", "wheelSpin", "wheelEmpty", "wheelWon", "wheelBag", "won", "lost", "win", "loss"],
          "properties": {
            "lotteryAbout": { "type": "string", "minLength": 1 },
            "lotteryToday": { "type": "string", "minLength": 1 },
            "lotteryBuy": { "type": "string", "minLength": 1 },
            "lotteryHas": { "type": "string", "minLength": 1 },
            "lotteryBought": { "type": "string", "minLength": 1 },
            "lotteryYesterday": { "type": "string", "minLength": 1 },
            "lotteryEarlier": { "type": "string", "minLength": 1 },
            "lotteryMine": { "type": "string", "minLength": 1 },
            "lotteryNone": { "type": "string", "minLength": 1 },
            "lotteryPlayers": { "type": "string", "minLength": 1, "description": "Nagłówek zwiniętej listy graczy, którzy kupili dziś los; {tickets} to ich liczba." },
            "announce": { "type": "string", "minLength": 1, "description": "Komunikat Systemu w czacie i w Salonie po losowaniu: {name} zwycięzcy, {gold} złota, [a|b] forma dla kobiety i dla mężczyzny." },
            "wheelAbout": { "type": "string", "minLength": 1 },
            "wheelPool": { "type": "string", "minLength": 1 },
            "wheelPoolAbout": { "type": "string", "minLength": 1 },
            "wheelStake": { "type": "string", "minLength": 1 },
            "wheelSpin": { "type": "string", "minLength": 1 },
            "wheelEmpty": { "type": "string", "minLength": 1 },
            "wheelWon": { "type": "string", "minLength": 1 },
            "wheelBag": { "type": "string", "minLength": 1 },
            "won": { "type": "string", "minLength": 1 },
            "lost": { "type": "string", "minLength": 1 },
            "win": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Słowa gospodarza po wygranej." },
            "loss": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Słowa gospodarza po przegranej." }
          }
        }
      }
    },
    "tavern": { "type": "object", "additionalProperties": false, "required": ["resident", "relationGain", "mugGoldPerLevel", "rumor"], "properties": { "resident": { "type": "string", "description": "Karczmarz: id mieszkańca, przy którym rośnie relacja o relationGain za kufel." }, "relationGain": { "type": "integer", "minimum": 0 }, "mugGoldPerLevel": { "type": "number", "exclusiveMinimum": 0 }, "rumor": { "type": "object", "additionalProperties": false, "required": ["factor", "newest", "lines"], "properties": { "factor": { "type": "number", "minimum": 1 }, "newest": { "type": "integer", "minimum": 1 }, "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } } },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hours", "fee", "offers", "brotherhood", "minRaise", "maxPrice", "kinds", "reputation", "merchant", "wanderer", "testSeller", "testMinutes", "resident"],
      "description": "Targowisko (część III, pytania 237–242): oferty graczy jak aukcje i oferty mieszkańców (src/engine/market.js). Oferta trwa hours godzin, z ceną wywoławczą i opcjonalną ceną „Kup teraz”. Targowisko bierze fee ceny sprzedaży. Postać ma naraz offers ofert i jedną więcej na każdy stopień reputacji bractwa brotherhood ponad pierwszy. Kolejna oferta w licytacji to co najmniej minRaise więcej, nie mniej niż złoto więcej. Ceny do maxPrice. kinds: co da się wystawić. reputation: punkt reputacji bractwa za każde goldPerPointPerLevel złota razy poziom postaci z handlu, najwyżej daily dziennie. merchant: kupiec codziennie sprzedaje goods sztuk rodzajów (zioła, materiały rzadkości materialRarities, części rzadkości partRarities) po cenie margin razy więcej niż najwyższa cena skupu u NPC, razy wahanie dnia z zakresu swing; postać kupi dziennie do stock sztuk każdego. wanderer: raz w tygodniu, na dobę, wędrowny handlarz ma items przedmiotów na poziom postaci, rzadkości losowanych z wagami rarities, po cenie priceFactor razy tyle, ile płaci złomiarz. testSeller i testMinutes: na wersji testowej „Testuj Osadę” wystawia próbne oferty od tego handlarza, na tyle minut.",
      "properties": {
        "hours": { "type": "number", "exclusiveMinimum": 0 },
