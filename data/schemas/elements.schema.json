{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Żywioły",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "resistance"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "resistance": { "type": "string", "minLength": 1 }
    }
  }
}
