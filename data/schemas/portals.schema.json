{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portale Systemu",
  "type": "object",
  "additionalProperties": false,
  "required": ["sweeps", "maxStage", "strength", "lootMinutes", "firstWinMultiplier", "portals", "texts", "series"],
  "properties": {
    "$comment": { "type": "string" },
    "sweeps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perDay"],
      "properties": { "perDay": { "type": "integer", "minimum": 1, "description": "Czyszczenia dziennie w każdym portalu." } }
    },
    "maxStage": { "type": "integer", "minimum": 1, "description": "Najwyższy stopień portali: najwyższy poziom postaci z balance.json (progression.maxLevel). Na start 100, od 17.11.2026 500 (autor: „Portale trzeba zwiększyć tak daleko jak to możliwe”)." },
    "strength": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 1 }, "description": "[obrażenia, HP] stworów razy tyle co w Eksploracji." },
    "lootMinutes": { "type": "number", "exclusiveMinimum": 0, "description": "Łup wygranej i czyszczenia: tyle, ile średnio daje tyle minut wyprawy na poziomie stopnia." },
    "firstWinMultiplier": { "type": "number", "minimum": 1 },
    "portals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "loot"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "loot": { "enum": ["gold", "resource", "material", "part"], "description": "Czym płaci portal." },
          "resource": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Zasób obozu portalu zasobu." },
          "part": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Część portalu części, od której liczy się rzadkość." },
          "art": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Tło portalu w src/client/art." }
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fightStart", "won", "lost", "defeat", "loot", "swept", "sweptAll"],
      "properties": {
        "fightStart": { "$ref": "#/definitions/variants", "description": "Początek walki na stopniu; {enemies}: przeciwnicy z poziomami." },
        "won": { "$ref": "#/definitions/variants", "description": "{stage}: numer stopnia." },
        "lost": { "$ref": "#/definitions/variants" },
        "defeat": { "$ref": "#/definitions/variants", "description": "{target}: imię postaci." },
        "loot": { "$ref": "#/definitions/variants", "description": "{loot}: łup słowami." },
        "swept": { "$ref": "#/definitions/variants", "description": "Czyszczenie: {stage} i {loot}." },
        "sweptAll": { "$ref": "#/definitions/variants", "description": "„Wyczyść wszystkie”: {list}, każdy wyczyszczony portal z liczbą czyszczeń i łupem." }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["options", "page", "texts"],
      "description": "Kilka stopni naraz: przyciski obok „Walcz o stopień N” i zdania raportu serii.",
      "properties": {
        "$comment": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "hint"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "count": { "type": "integer", "minimum": 2, "description": "Najwięcej walk na jedno stuknięcie; bez count: o wszystkie otwarte stopnie." },
              "label": { "type": "string", "minLength": 1, "description": "Napis na przycisku." },
              "hint": { "type": "string", "minLength": 1, "description": "Co robi przycisk, pełnym zdaniem (podpowiedź i czytnik ekranu)." }
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "about", "lastFight"],
          "properties": {
            "group": { "type": "string", "minLength": 1, "description": "Nazwa grupy przycisków dla czytnika ekranu." },
            "about": { "type": "string", "minLength": 1, "description": "Zdanie w „Jak to działa?” Portali." },
            "lastFight": { "type": "string", "minLength": 1, "description": "Tytuł ostatniej walki w raporcie serii; {stage}." }
          }
        },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wonMany", "wonOne", "wonNone", "stopLost", "stopCount", "stopLevel", "stopLast", "range", "rangeOne", "chip", "entry"],
          "properties": {
            "wonMany": { "$ref": "#/definitions/variants", "description": "{from}–{to}: stopnie pokonane w serii." },
            "wonOne": { "$ref": "#/definitions/variants", "description": "{stage}: jedyny pokonany." },
            "wonNone": { "$ref": "#/definitions/variants" },
            "stopLost": { "$ref": "#/definitions/variants", "description": "Seria stanęła na porażce; {stage}." },
            "stopCount": { "$ref": "#/definitions/variants", "description": "Seria zrobiła swoje walki ({fights}), a {stage} jest otwarty." },
            "stopLevel": { "$ref": "#/definitions/variants", "description": "Seria doszła do poziomu postaci; {level}: poziom, na którym otworzy się kolejny." },
            "stopLast": { "$ref": "#/definitions/variants", "description": "Seria doszła do ostatniego stopnia portalu." },
            "range": { "$ref": "#/definitions/variants", "description": "Stopnie walk serii w zdaniu: {from}–{to}." },
            "rangeOne": { "$ref": "#/definitions/variants", "description": "Jedna walka: {stage}." },
            "chip": { "$ref": "#/definitions/variants", "description": "Dziennik: {won}, liczba pokonanych stopni." },
            "entry": { "$ref": "#/definitions/variants", "description": "Wpis pełnej relacji: {stage} i {text}, zdania jednej walki." }
          }
        }
      }
    }
  },
  "definitions": {
    "variants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
