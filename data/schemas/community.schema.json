{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Społeczność",
  "description": "Działy listy rozwijanej Społeczności, Ranking postaci, Znajomi, codzienny Upominek (src/server/community.js) i link zaproszenia na serwer Discord (src/client/discord.js).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "ranking", "friends", "gift", "trade", "discord"],
  "properties": {
    "$comment": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "name": { "type": "string" },
          "soon": { "type": "boolean" }
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page"],
      "properties": { "page": { "type": "integer", "minimum": 1 } }
    },
    "friends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max"],
      "properties": { "max": { "type": "integer", "minimum": 1 } }
    },
    "gift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "claimsPerDay", "keepDays", "timePoints", "goldChance", "gold", "resources"],
      "properties": {
        "name": { "type": "string" },
        "claimsPerDay": { "type": "integer", "minimum": 1 },
        "keepDays": { "type": "integer", "minimum": 1 },
        "timePoints": { "type": "integer", "minimum": 0 },
        "goldChance": { "type": "number", "minimum": 0, "maximum": 1 },
        "gold": { "$ref": "#/definitions/amount" },
        "resources": { "$ref": "#/definitions/amount" }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onlineSeconds", "proposalSeconds", "idleMinutes", "rejectionsInRow", "pauseMinutes", "maxItems", "minLevel"],
      "properties": {
        "onlineSeconds": { "type": "integer", "minimum": 30 },
        "proposalSeconds": { "type": "integer", "minimum": 10 },
        "idleMinutes": { "type": "integer", "minimum": 1 },
        "rejectionsInRow": { "type": "integer", "minimum": 1 },
        "pauseMinutes": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "minLevel": { "type": "integer", "minimum": 1 }
      }
    },
    "discord": {
      "description": "Serwer gry na Discordzie: link zaproszenia (pusty, dopóki go nie ma) i słowa przycisku.",
      "type": "object",
      "additionalProperties": false,
      "required": ["invite", "texts"],
      "properties": {
        "$comment": { "type": "string" },
        "invite": { "type": "string", "pattern": "^(https://(discord\\.gg|discord\\.com/invite)/[A-Za-z0-9-]+)?$" },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["join"],
          "properties": {
            "join": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "perLevel"],
      "properties": {
        "base": { "type": "number", "minimum": 0 },
        "perLevel": { "type": "number", "minimum": 0 }
      }
    }
  }
}
