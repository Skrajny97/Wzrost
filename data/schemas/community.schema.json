{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Społeczność",
  "description": "Działy listy rozwijanej Społeczności, Ranking postaci, Znajomi, codzienny Upominek (src/server/community.js) link zaproszenia na serwer Discord (src/client/discord.js) oraz Facebook, TikTok i Wattpad gry (src/client/social.js) i słowa Drużyny (src/server/parties.js).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "ranking", "friends", "gift", "trade", "referral", "discord", "social", "party"],
  "properties": {
    "$comment": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "name": { "type": "string" },
          "soon": { "type": "boolean" }
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page"],
      "properties": { "page": { "type": "integer", "minimum": 1 } }
    },
    "friends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max"],
      "properties": { "max": { "type": "integer", "minimum": 1 } }
    },
    "gift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "claimsPerDay", "keepDays", "timePoints", "goldChance", "gold", "resources"],
      "properties": {
        "name": { "type": "string" },
        "claimsPerDay": { "type": "integer", "minimum": 1 },
        "keepDays": { "type": "integer", "minimum": 1 },
        "timePoints": { "type": "integer", "minimum": 0 },
        "goldChance": { "type": "number", "minimum": 0, "maximum": 1 },
        "gold": { "$ref": "#/definitions/amount" },
        "resources": { "$ref": "#/definitions/amount" }
      }
    },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onlineSeconds", "proposalSeconds", "idleMinutes", "rejectionsInRow", "pauseMinutes", "maxItems", "minLevel"],
      "properties": {
        "onlineSeconds": { "type": "integer", "minimum": 30 },
        "proposalSeconds": { "type": "integer", "minimum": 10 },
        "idleMinutes": { "type": "integer", "minimum": 1 },
        "rejectionsInRow": { "type": "integer", "minimum": 1 },
        "pauseMinutes": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "minLevel": { "type": "integer", "minimum": 1 }
      }
    },
    "referral": {
      "description": "Poleć grę (982 A, 985): kod linku, Punkty Systemu na start, progi z nagrodami polecającego i nowego gracza, limit nagród w miesiącu i słowa.",
      "type": "object",
      "additionalProperties": false,
      "required": ["codeLength", "start", "milestones", "perMonth", "texts"],
      "properties": {
        "$comment": { "type": "string" },
        "codeLength": { "type": "integer", "minimum": 5, "maximum": 12 },
        "start": { "type": "integer", "minimum": 0 },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "referrer", "newcomer"],
            "properties": { "level": { "type": "integer", "minimum": 1 }, "referrer": { "type": "integer", "minimum": 0 }, "newcomer": { "type": "integer", "minimum": 0 } }
          }
        },
        "perMonth": { "type": "integer", "minimum": 1 },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "rules", "copy", "copied", "share", "shareText", "month", "players", "given", "waiting", "claim", "unconfirmed", "noCharacter", "invited", "invitedDone", "claimed", "limit", "inviteTitle", "invite"],
          "patternProperties": { "^[a-zA-Z]+$": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "discord": {
      "description": "Serwer gry na Discordzie: link zaproszenia (pusty, dopóki go nie ma) i słowa przycisku.",
      "type": "object",
      "additionalProperties": false,
      "required": ["invite", "texts"],
      "properties": {
        "$comment": { "type": "string" },
        "invite": { "type": "string", "pattern": "^(https://(discord\\.gg|discord\\.com/invite)/[A-Za-z0-9-]+)?$" },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["join"],
          "properties": {
            "join": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "party": {
      "description": "Drużyna: słowa przekazania przywództwa (przycisk, pytanie, odpowiedź i odmowy) i rubryki mikstur członka na wyprawę drużyny (nagłówek, wskazówka, brak mikstur).",
      "type": "object",
      "additionalProperties": false,
      "required": ["texts"],
      "properties": {
        "$comment": { "type": "string" },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lead", "leadTitle", "leadText", "leadConfirm", "led", "notLeader", "self", "potionsTitle", "potionsHint", "potionsNone"],
          "properties": {
            "lead": { "type": "string", "minLength": 1 },
            "leadTitle": { "type": "string", "minLength": 1 },
            "leadText": { "type": "string", "pattern": "\\{name\\}" },
            "leadConfirm": { "type": "string", "minLength": 1 },
            "led": { "type": "string", "pattern": "\\{name\\}" },
            "notLeader": { "type": "string", "minLength": 1 },
            "self": { "type": "string", "minLength": 1 },
            "potionsTitle": { "type": "string", "minLength": 1 },
            "potionsHint": { "type": "string", "minLength": 1 },
            "potionsNone": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "social": {
      "description": "Facebook, TikTok i Wattpad gry: każde miejsce to wiersz w Ustawieniach pod Discordem, z przyciskiem ze znakiem miejsca i słowami (label), który otwiera link (url, pusty: wiersza nie ma). Link musi prowadzić do tego miejsca.",
      "type": "object",
      "additionalProperties": false,
      "required": ["places"],
      "properties": {
        "$comment": { "type": "string" },
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "label"],
            "properties": {
              "id": { "enum": ["facebook", "tiktok", "wattpad"] },
              "url": { "type": "string", "pattern": "^(https://(www\\.)?(facebook\\.com|tiktok\\.com|wattpad\\.com)/[^\\s]+)?$" },
              "label": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              { "if": { "properties": { "id": { "const": "facebook" } } }, "then": { "properties": { "url": { "pattern": "^(https://(www\\.)?facebook\\.com/.+)?$" } } } },
              { "if": { "properties": { "id": { "const": "tiktok" } } }, "then": { "properties": { "url": { "pattern": "^(https://(www\\.)?tiktok\\.com/.+)?$" } } } },
              { "if": { "properties": { "id": { "const": "wattpad" } } }, "then": { "properties": { "url": { "pattern": "^(https://(www\\.)?wattpad\\.com/.+)?$" } } } }
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "perLevel"],
      "properties": {
        "base": { "type": "number", "minimum": 0 },
        "perLevel": { "type": "number", "minimum": 0 }
      }
    }
  }
}
