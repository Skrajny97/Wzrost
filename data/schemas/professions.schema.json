{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Profesje",
  "description": "Profesje, ich poziomy i statystyki, zbieractwo w Systemowym Zagajniku, zioła, warzenie w Systemowej Pracowni i mikstury (src/engine/professions.js, src/engine/brewing.js).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules",
    "avatar",
    "intro",
    "professions",
    "gathering",
    "brewing",
    "workshop",
    "potionUse",
    "herbs",
    "potions",
    "texts"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterXpShare",
        "stack"
      ],
      "properties": {
        "characterXpShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ile XP postaci daje godzina pracy, jako część XP z godziny wyprawy na tym samym poziomie."
        },
        "stack": {
          "type": "integer",
          "minimum": 1,
          "description": "Ile sztuk zioła mieści jedno miejsce plecaka."
        }
      }
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "description": "Słowa Systemu na górze zakładki Profesje."
    },
    "professions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "genitive",
          "kind",
          "stats",
          "maxLevel",
          "levelMinutes",
          "statPerLevel",
          "maxLevelBonus",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "genitive": {
            "type": "string",
            "minLength": 1,
            "description": "Nazwa w dopełniaczu: „Osiągnięto poziom Zielarstwa: 5”."
          },
          "kind": {
            "enum": [
              "gathering",
              "crafting"
            ]
          },
          "stats": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Dwie statystyki ze stats.json, które rosną z poziomem profesji."
          },
          "maxLevel": {
            "type": "integer",
            "minimum": 2
          },
          "levelMinutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Awans z poziomu L wymaga L razy tyle minut pracy."
          },
          "statPerLevel": {
            "type": "integer",
            "minimum": 1
          },
          "maxLevelBonus": {
            "type": "integer",
            "minimum": 0,
            "description": "Dodatek do obu statystyk na ostatnim poziomie: nagroda za opanowanie profesji."
          },
          "soon": {
            "type": "boolean",
            "description": "Profesja jest w zakładce, ale jeszcze bez pracy."
          },
          "unlockLevel": {
            "type": "integer",
            "minimum": 1,
            "description": "Poziom postaci, od którego profesja się otwiera, gdy później niż zakładka Profesje (data/unlocks.json)."
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gathering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profession",
        "place",
        "minutes",
        "yieldPerLevel",
        "spread",
        "slots"
      ],
      "properties": {
        "profession": {
          "type": "string",
          "minLength": 1,
          "description": "Profesja zbieracka, która zbiera zioła."
        },
        "place": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "description"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "minutes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "step",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "step": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "yieldPerLevel": {
          "type": "number",
          "minimum": 0
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "description": "Od którego poziomu ile ziół zbiera się naraz; pierwszy wpis od poziomu 1.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "herbs"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1
              },
              "herbs": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "brewing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profession",
        "place",
        "potionMinutes",
        "speedPerLevel",
        "fastest",
        "maxMinutes",
        "bonusChance",
        "priceFactor",
        "texts"
      ],
      "properties": {
        "profession": {
          "type": "string",
          "minLength": 1,
          "description": "Profesja wytwórcza, która warzy mikstury."
        },
        "place": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "description"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "potionMinutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Ile minut trwa jedna mikstura na 1. poziomie profesji."
        },
        "speedPerLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1,
          "description": "O jaką część czasu mikstury skraca ją każdy poziom profesji."
        },
        "fastest": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Najkrótszy czas mikstury, jako część czasu z 1. poziomu."
        },
        "maxMinutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Najdłuższe warzenie naraz, w minutach."
        },
        "bonusChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Szansa każdej uwarzonej mikstury na jedną dodatkową."
        },
        "priceFactor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Ile razy więcej niż za zioła mikstury płaci złomiarz."
        },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report",
            "brewed",
            "lucky",
            "lost",
            "stopped",
            "revealed",
            "hidden",
            "busy",
            "claimFirst",
            "pushTitle",
            "pushBody"
          ],
          "properties": {
            "report": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "brewed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lucky": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lost": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "stopped": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "revealed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hidden": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "busy": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "claimFirst": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pushTitle": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pushBody": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "price", "description", "texts"],
      "description": "Awatar Systemu: kupiony raz na zawsze za price złota wykonuje jedną pracę naraz obok postaci, z jej poziomami profesji, ziołami, przepisami i wzorami. Nie daje XP, poziomów profesji ani statystyk.",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": "integer", "minimum": 1, "description": "Cena w złocie, płacona raz." },
        "description": { "type": "string", "minLength": 1, "description": "Opis na karcie zakupu w zakładce Profesje." },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bought", "busy", "claimFirst", "pushTitle"],
          "description": "bought: po zakupie; busy i claimFirst: gdy Awatar dostaje nową pracę, choć jeszcze pracuje albo czeka na odbiór raportu; pushTitle: tytuł powiadomienia na telefonie o końcu jego pracy (treść jest ta sama co przy postaci).",
          "properties": {
            "bought": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "busy": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "claimFirst": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "pushTitle": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "workshop": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rzemieślnictwo: wyrób ekwipunku z części w miejscu Systemu (src/engine/workshop.js).",
      "required": [
        "profession",
        "place",
        "parts",
        "resources",
        "itemMinutes",
        "rarityTime",
        "speedPerLevel",
        "fastest",
        "maxCount",
        "laterPatternLevel",
        "chancePerLevel",
        "maxChance",
        "rarities",
        "texts"
      ],
      "properties": {
        "profession": {
          "type": "string",
          "minLength": 1,
          "description": "Profesja wytwórcza, która wykonuje przedmioty."
        },
        "place": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "description"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "parts": {
          "type": "object",
          "description": "Ile części rzadkości przedmiotu idzie na jeden przedmiot, według miejsca (slots.json). Tylko te miejsca da się wykonać.",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stone",
            "extra",
            "families"
          ],
          "properties": {
            "stone": {
              "type": "integer",
              "minimum": 0,
              "description": "Kamień na każdą część i każdy stopień rzadkości (pospolity 1, rzadki 2…), przy każdym przedmiocie."
            },
            "extra": {
              "type": "integer",
              "minimum": 0,
              "description": "Zasób rodziny (families) na każdą część i każdy stopień rzadkości."
            },
            "families": {
              "type": "object",
              "description": "Rodziny przedmiotów (item-bases.json) z drewna albo metalu: zasób → rodziny. Reszta bierze sam kamień.",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "itemMinutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Ile minut trwa pospolity przedmiot na 1. poziomie profesji."
        },
        "rarityTime": {
          "type": "number",
          "minimum": 1,
          "description": "Ile razy dłużej trwa przedmiot każdej rzadkości wyżej."
        },
        "speedPerLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1,
          "description": "O jaką część czasu przedmiotu skraca go każdy poziom profesji."
        },
        "fastest": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Najkrótszy czas przedmiotu, jako część czasu z 1. poziomu."
        },
        "maxCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Najwięcej sztuk jednym zleceniem."
        },
        "laterPatternLevel": {
          "type": "integer",
          "minimum": 1,
          "description": "Od którego poziomu profesji System odsłania wzory późniejszych baz rodziny (classLevel w item-bases.json)."
        },
        "chancePerLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1,
          "description": "O ile każdy poziom profesji podnosi szansę powodzenia."
        },
        "maxChance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Najwyższa szansa powodzenia rzadkości, która nie udaje się zawsze."
        },
        "rarities": {
          "type": "array",
          "minItems": 1,
          "description": "Rzadkości wyrobów po kolei: od którego poziomu profesji i z jaką szansą powodzenia na tym poziomie.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "level",
              "chance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "integer",
                "minimum": 1
              },
              "chance": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "report",
            "made",
            "failed",
            "stopped",
            "revealed",
            "rarity",
            "hidden",
            "busy",
            "claimFirst",
            "pushTitle",
            "pushBody"
          ],
          "properties": {
            "report": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "made": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "failed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "stopped": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "revealed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rarity": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hidden": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "busy": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "claimFirst": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pushTitle": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pushBody": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "potionUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healBelow",
        "healBelowChoices",
        "texts"
      ],
      "description": "Picie mikstur: próg leczenia w walce i teksty walki oraz raportu.",
      "properties": {
        "healBelow": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Domyślny próg: mikstura leczenia działa, gdy HP spadnie poniżej tej części maks. HP."
        },
        "healBelowChoices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "description": "Progi do wyboru przy „Wyrusz”."
        },
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drinkHeal",
            "drinkMana",
            "drunkHeal",
            "drunkSpeed",
            "used",
            "speedFights"
          ],
          "properties": {
            "drinkHeal": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "drinkMana": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "drunkHeal": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "drunkSpeed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "used": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "speedFights": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "herbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "genitive",
          "level",
          "perHour",
          "price",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "genitive": {
            "type": "string",
            "minLength": 1,
            "description": "Nazwa w dopełniaczu, do zadań narratora („Zbierz 12 sztuk Żywokostu”)."
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "description": "Poziom profesji, od którego postać zna to zioło."
          },
          "perHour": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "price": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "potions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "counted",
          "level",
          "herbs",
          "effect",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "counted": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Nazwa po liczbie: 1, 2–4, 5 i więcej („Uwarz 3 Mniejsze mikstury leczenia”)."
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "description": "Poziom profesji, od którego postać zna ten przepis."
          },
          "herbs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Zioła na jedną miksturę: id zioła i liczba sztuk."
          },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
