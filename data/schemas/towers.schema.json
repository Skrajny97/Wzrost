{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wieże Systemu",
  "type": "object",
  "additionalProperties": false,
  "required": ["towers", "floors"],
  "properties": {
    "$comment": { "type": "string" },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "members", "companions", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "members": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
          "companions": { "type": "boolean" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "floors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eliteEvery", "eliteChance", "championEvery"],
      "properties": {
        "eliteEvery": { "type": "integer", "minimum": 1 },
        "eliteChance": { "type": "number", "minimum": 0, "maximum": 1 },
        "championEvery": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
