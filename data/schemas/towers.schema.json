{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wieże Systemu",
  "type": "object",
  "additionalProperties": false,
  "required": ["towers", "floors", "entries", "firstFloorLevel", "strength", "rewardMinutes", "chestEvery", "loot", "texts"],
  "properties": {
    "$comment": { "type": "string" },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "members", "companions", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "place": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "members": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
          "companions": { "type": "boolean" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "floors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eliteEvery", "eliteLapEvery", "eliteChance", "championEvery"],
      "properties": {
        "eliteEvery": { "type": "integer", "minimum": 1 },
        "eliteLapEvery": { "type": "integer", "minimum": 1, "description": "Stałe elity co eliteEvery piętro tylko w co eliteLapEvery okrążeniu regionów, od pierwszego (1: w każdym)." },
        "eliteChance": { "type": "number", "minimum": 0, "maximum": 1 },
        "championEvery": { "type": "integer", "minimum": 1 }
      }
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perDay"],
      "properties": { "perDay": { "type": "integer", "minimum": 1 } }
    },
    "firstFloorLevel": { "type": "integer", "minimum": 1, "description": "Poziom piętra 1; każde kolejne piętro o jeden wyżej." },
    "strength": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 }, "description": "O tyle System wzmacnia stwory w Wieżach: [obrażenia, HP]." },
    "rewardMinutes": { "type": "integer", "minimum": 1 },
    "chestEvery": { "type": "integer", "minimum": 1 },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goldMultiplier", "materials", "itemChance"],
      "properties": {
        "goldMultiplier": { "type": "number", "exclusiveMinimum": 0, "description": "Wygrana płaci złotem tyle, ile średnio cała wyprawa rewardMinutes minut na poziomie piętra, razy tyle." },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pieces", "rarities"],
          "properties": {
            "pieces": { "type": "integer", "minimum": 1, "description": "Ile materiałów stworów piętra na pewno daje wygrana." },
            "rarities": {
              "type": "array",
              "minItems": 1,
              "description": "Wagi rzadkości każdej sztuki od poziomu piętra fromLevel (najwyższy osiągnięty próg); nigdy poniżej rzadkości gatunku.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fromLevel", "rarities"],
                "properties": {
                  "fromLevel": { "type": "integer", "minimum": 1 },
                  "rarities": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } }
                }
              }
            }
          }
        },
        "itemChance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Szansa, że wygrana da też przedmiot klasy postaci na poziomie piętra, o rzadkości przedmiotu czempiona (championItems)." }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["won", "lost", "defeat", "fightStart", "eliteStart", "championStart", "chest", "loot"],
      "properties": {
        "won": { "$ref": "#/definitions/variants" },
        "lost": { "$ref": "#/definitions/variants" },
        "defeat": { "$ref": "#/definitions/variants" },
        "fightStart": { "$ref": "#/definitions/variants", "description": "Początek walki na piętrze; {enemies}: przeciwnicy z poziomami." },
        "eliteStart": { "$ref": "#/definitions/variants" },
        "championStart": { "$ref": "#/definitions/variants" },
        "chest": { "$ref": "#/definitions/variants" },
        "loot": { "$ref": "#/definitions/variants", "description": "Przedmiot z łupów Wieży (itemChance); {item}: jego nazwa." }
      }
    }
  },
  "definitions": {
    "variants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
