{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Czat",
  "description": "Czat w zakładce Społeczność: kanały, zasady pisania, słowa zamieniane na gwiazdki i zasady czatu do zaakceptowania (src/server/chat.js).",
  "type": "object",
  "additionalProperties": false,
  "required": ["channels", "rules", "words", "names", "texts"],
  "properties": {
    "$comment": { "type": "string" },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "name": { "type": "string" },
          "items": { "type": "boolean", "description": "Wiadomość może pokazać przedmioty z plecaka (oferty Wymiany)." }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxLength", "everySeconds", "keep", "privateKeep", "items", "conversations", "page", "hideAfterReports", "pollSeconds"],
      "properties": {
        "maxLength": { "type": "integer", "minimum": 1 },
        "everySeconds": { "type": "integer", "minimum": 0 },
        "keep": { "type": "integer", "minimum": 1 },
        "privateKeep": { "type": "integer", "minimum": 1 },
        "items": { "type": "integer", "minimum": 1, "description": "Ile najwyżej przedmiotów pokazuje jedna wiadomość w kanale z items." },
        "conversations": { "type": "integer", "minimum": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "hideAfterReports": { "type": "integer", "minimum": 1 },
        "pollSeconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "words": { "type": "array", "items": { "type": "string", "pattern": "^[a-ząćęłńóśźż]+$" } },
    "names": {
      "type": "object",
      "description": "Filtr imion postaci (src/engine/names.js) z listą words: niepomijalny komunikat dla postaci, której imię łamie zasady, i odmowa przy tworzeniu postaci.",
      "additionalProperties": false,
      "required": ["blocked", "refused", "label", "button", "done"],
      "properties": {
        "blocked": { "type": "string", "minLength": 1 },
        "refused": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "button": { "type": "string", "minLength": 1 },
        "done": { "type": "string", "minLength": 1 }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
