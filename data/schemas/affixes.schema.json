{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Afiksy",
  "description": "Przedrostki i przyrostki dają przedmiotowi statystyki (stat, weight). Nazwy afiksów biorą się ze stworów miejsca, w którym przedmiot znaleziono (names). Pole monster albo text przy afiksie nazywa przedmioty znalezione przed 26.10.2026.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prefixes", "suffixes", "names"],
  "definitions": {
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m", "f", "n", "pl"],
      "properties": {
        "m": { "type": "string", "minLength": 1 },
        "f": { "type": "string", "minLength": 1 },
        "n": { "type": "string", "minLength": 1 },
        "pl": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "prefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "monster", "stat", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "monster": { "type": "string", "minLength": 1 },
          "stat": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "suffixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stat", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "monster": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "stat": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["monster", "suffix"],
        "properties": {
          "monster": { "type": "string", "minLength": 1 },
          "prefix": { "$ref": "#/definitions/forms" },
          "suffix": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
