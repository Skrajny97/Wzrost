{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Afiksy",
  "type": "object",
  "additionalProperties": false,
  "required": ["prefixes", "suffixes"],
  "properties": {
    "prefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "forms", "stat", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "forms": {
            "type": "object",
            "additionalProperties": false,
            "required": ["m", "f", "n", "pl"],
            "properties": {
              "m": { "type": "string", "minLength": 1 },
              "f": { "type": "string", "minLength": 1 },
              "n": { "type": "string", "minLength": 1 },
              "pl": { "type": "string", "minLength": 1 }
            }
          },
          "stat": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "suffixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "stat", "weight"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "text": { "type": "string", "minLength": 1 },
          "stat": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
