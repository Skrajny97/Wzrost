{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Osiągnięcia (achievements.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "since",
    "texts",
    "groups"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "since": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liczniki prowadzone od wersji, która je wprowadziła."
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "since"
      ],
      "properties": {
        "since": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "list"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "list": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "goal",
                "count",
                "target",
                "title",
                "reward",
                "art"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "goal": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "enum": [
                    "monsters",
                    "champions",
                    "wanted",
                    "gold",
                    "arenaWins",
                    "leagueWins",
                    "labyrinths",
                    "deals",
                    "level",
                    "thirdForm",
                    "professionTop",
                    "professionsAt50",
                    "professionsAt100",
                    "cards",
                    "landCards",
                    "arenaRating",
                    "guildWeeks",
                    "towerFloor",
                    "friends",
                    "streaks",
                    "landPlaces",
                    "landReached",
                    "andrzejki"
                  ]
                },
                "target": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Tytuł postaci mężczyzny i kobiety."
                },
                "reward": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "timePoints": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "systemPoints": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "art": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "land": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Kraina (land z regions.json, po polsku) dla landPlaces i landReached."
                }
              }
            }
          }
        }
      }
    }
  }
}
