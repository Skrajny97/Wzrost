{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zdarzenia na końcu wyprawy",
  "type": "object",
  "additionalProperties": false,
  "required": ["chancePerMinute", "maxChance", "texts", "list", "foes"],
  "properties": {
    "$comment": { "type": "string" },
    "chancePerMinute": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Szansa na zdarzenie za każdą minutę wyprawy." },
    "maxChance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Najwyższa szansa na zdarzenie, przy dowolnie długiej wyprawie." },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loot"],
      "properties": {
        "loot": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Zdanie relacji o przedmiocie zostawionym przez pokonanych, z {item}." }
      }
    },
    "list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "art", "scene", "text", "options"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "art": { "type": "string", "minLength": 1, "description": "Postać zdarzenia: src/client/art/events/<art>.png." },
          "scene": { "type": "string", "minLength": 1, "description": "Tło zdarzenia: src/client/art/event-scenes/<scene>.png." },
          "text": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "description": "Waga losowania zdarzenia (domyślnie 1)." },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "text", "outcome"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "label": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "outcome": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind"],
                  "properties": {
                    "kind": { "enum": ["none", "fight"] },
                    "foes": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
                    "ambush": { "type": "boolean", "description": "Wrogowie ruszają pierwsi, wszyscy przed postacią." },
                    "speedBonus": { "type": "number", "exclusiveMinimum": 0, "description": "Postać jest w tej walce szybsza o taką część." },
                    "itemChance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Szansa, że pokonany wróg zostawi przedmiot." },
                    "start": { "type": "string", "minLength": 1, "description": "Zdanie relacji przed walką, z {enemies}." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "foes": {
      "type": "array",
      "description": "Przeciwnicy zdarzeń, w kształcie stworów z monsters.json (sprawdza je schemat monsters.schema.json).",
      "items": { "type": "object" }
    }
  }
}
