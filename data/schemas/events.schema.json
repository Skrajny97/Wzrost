{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zdarzenia na końcu wyprawy",
  "type": "object",
  "additionalProperties": false,
  "required": ["chance", "texts", "list", "foes"],
  "definitions": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "description": "Skutek opcji: tekst i co z niego wynika.",
      "properties": {
        "kind": { "enum": ["none", "fight", "reward"] },
        "weight": { "type": "number", "exclusiveMinimum": 0, "description": "Waga skutku na liście skutków, losowanych przy wyborze opcji." },
        "text": { "type": "string", "minLength": 1, "description": "Tekst skutku; przy nagrodzie z {gold} albo {item}." },
        "foes": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "ambush": { "type": "boolean", "description": "Wrogowie ruszają pierwsi, wszyscy przed postacią." },
        "speedBonus": { "type": "number", "exclusiveMinimum": 0, "description": "Postać jest w tej walce szybsza o taką część." },
        "itemChance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Szansa, że pokonany wróg zostawi przedmiot." },
        "start": { "type": "string", "minLength": 1, "description": "Zdanie relacji przed walką, z {enemies}." },
        "gold": { "type": "number", "exclusiveMinimum": 0, "description": "Złoto nagrody: tyle razy rewards.goldPerLevel × poziom postaci, ±25%." },
        "itemRarities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 },
          "description": "Przedmiot nagrody na poziomie postaci: wagi jego rzadkości."
        }
      }
    },
    "outcomes": {
      "description": "Jeden skutek albo lista skutków z wagami, z której los wybiera przy wyborze opcji.",
      "oneOf": [{ "$ref": "#/definitions/outcome" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/outcome" } }]
    }
  },
  "properties": {
    "$comment": { "type": "string" },
    "chance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Szansa na zdarzenie po wyprawie zakończonej zgodnie z planem." },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loot"],
      "properties": {
        "loot": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Zdanie relacji o przedmiocie zostawionym przez pokonanych, z {item}." }
      }
    },
    "list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "art", "scene", "figure", "text", "options"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "art": { "type": "string", "minLength": 1, "description": "Postać zdarzenia: src/client/art/events/<art>.png." },
          "scene": { "type": "string", "minLength": 1, "description": "Tło zdarzenia: src/client/art/event-scenes/<scene>.png." },
          "figure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "bottom", "height"],
            "description": "Miejsce postaci na tle, w procentach tła: od lewej krawędzi, od dołu i wysokość postaci.",
            "properties": {
              "left": { "type": "number", "minimum": 0, "maximum": 100 },
              "bottom": { "type": "number", "minimum": 0, "maximum": 100 },
              "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
            }
          },
          "text": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "description": "Waga losowania zdarzenia (domyślnie 1)." },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "label": { "type": "string", "minLength": 1 },
                "outcome": { "$ref": "#/definitions/outcomes", "description": "Skutek opcji, gdy przypadek nie podaje własnego." }
              }
            }
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "description": "Co naprawdę się dzieje, losowane raz na zdarzenie z wagą weight. Przypadek podaje skutki opcji (outcomes, po id opcji); opcja bez skutku w przypadku ma swój własny.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "weight", "outcomes"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "name": { "type": "string", "minLength": 1, "description": "Nazwa przypadku w „Testuj zdarzenia”." },
                "weight": { "type": "number", "exclusiveMinimum": 0 },
                "outcomes": { "type": "object", "additionalProperties": { "$ref": "#/definitions/outcomes" } }
              }
            }
          }
        }
      }
    },
    "foes": {
      "type": "array",
      "description": "Przeciwnicy zdarzeń, w kształcie stworów z monsters.json (sprawdza je schemat monsters.schema.json).",
      "items": { "type": "object" }
    }
  }
}
