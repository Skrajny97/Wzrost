{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sloty ekwipunku",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "column"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "column": { "enum": ["left", "right"] },
      "locked": { "type": "boolean" }
    }
  }
}
