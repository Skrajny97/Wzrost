{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sklep Systemu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "texts"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "price"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "description": "frame: ramka portretu, background: tło portretu, mountSkin: wygląd wierzchowca ze Stajni, aura: światło wokół postaci, trail: świecące ślady za postacią w scenie Walki.",
            "enum": [
              "frame",
              "background",
              "mountSkin",
              "aura",
              "trail"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "description": "Cena w Punktach Systemu.",
            "type": "integer",
            "minimum": 1
          },
          "art": {
            "description": "Obrazek bez .png: ramki i tła w src/client/art/cosmetics, wygląd wierzchowca w src/client/art/mounts.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "window": {
            "description": "Przezroczyste okno ramki w obrazku 120 × 160: [lewo, góra, prawo, dół] włącznie.",
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "nameColor": {
            "description": "Kolor imienia postaci w tej ramce.",
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "shine",
                  "pulse",
                  "fireflies"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/point"
                }
              }
            }
          },
          "aura": {
            "description": "Światło aury: kolor poświaty (glow), kolor drobinek (spark) i ich ruch (sparks: drift krąży, rise leci w górę).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "glow",
              "spark",
              "sparks"
            ],
            "properties": {
              "glow": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "spark": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "sparks": {
                "enum": [
                  "drift",
                  "rise"
                ]
              }
            }
          },
          "trail": {
            "description": "Kolor świecących śladów.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color"
            ],
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "frame"
                }
              }
            },
            "then": {
              "required": [
                "window",
                "nameColor",
                "effect"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "window"
                    ]
                  },
                  {
                    "required": [
                      "nameColor"
                    ]
                  },
                  {
                    "required": [
                      "effect"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "frame",
                    "background",
                    "mountSkin"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "art"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "art"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "aura"
                }
              }
            },
            "then": {
              "required": [
                "aura"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "aura"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "trail"
                }
              }
            },
            "then": {
              "required": [
                "trail"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "trail"
                ]
              }
            }
          }
        ]
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead",
        "rules"
      ],
      "properties": {
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
