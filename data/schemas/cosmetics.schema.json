{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sklep Systemu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "texts"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "price"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "description": "frame: ramka portretu, background: tło portretu, mountSkin: wygląd wierzchowca ze Stajni, aura: światło wokół postaci, trail: świecące ślady za postacią w scenie Walki, pet: chowaniec przy postaci w scenie Walki i na portrecie.",
            "enum": [
              "frame",
              "background",
              "mountSkin",
              "aura",
              "trail",
              "pet"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "description": "Cena w Punktach Systemu.",
            "type": "integer",
            "minimum": 1
          },
          "art": {
            "description": "Obrazek bez .png: ramki i tła w src/client/art/cosmetics, wygląd wierzchowca w src/client/art/mounts.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "window": {
            "description": "Przezroczyste okno ramki w obrazku 120 × 160: [lewo, góra, prawo, dół] włącznie.",
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "nameColor": {
            "description": "Kolor imienia postaci w tej ramce.",
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "shine",
                  "pulse",
                  "fireflies"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/point"
                }
              }
            }
          },
          "aura": {
            "description": "Światło aury: kolor poświaty (glow), kolor drobinek (spark) i ich ruch (sparks: drift krąży, rise leci w górę).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "glow",
              "spark",
              "sparks"
            ],
            "properties": {
              "glow": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "spark": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "sparks": {
                "enum": [
                  "drift",
                  "rise"
                ]
              }
            }
          },
          "trail": {
            "description": "Kolor świecących śladów.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color"
            ],
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              }
            }
          },
          "pet": {
            "description": "Chowaniec: arkusz klatek w scenie Walki (walk), jego miejsce przy pudełku postaci, gdy idzie (foot) i gdy jedzie na wierzchowcu (ride), oraz arkusz i miejsce na portrecie (portrait).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "walk",
              "foot",
              "ride",
              "portrait"
            ],
            "properties": {
              "walk": {
                "description": "Arkusz w scenie Walki, w skali 1: klatki po size × size pikseli w jednym rzędzie, przodem w prawo.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "size",
                  "frames",
                  "fps"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/definitions/petFile"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "foot": {
                "$ref": "#/definitions/petPlace"
              },
              "ride": {
                "$ref": "#/definitions/petPlace"
              },
              "portrait": {
                "description": "Arkusz na portrecie (klatki po size × size pikseli portretu 96 × 128) i lewy górny róg klatki (x, y) w pikselach portretu: od lewego górnego rogu portretu, a z anchor shoulder od miejsca na barku za głową postaci (perches w src/client/art.js).",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "size",
                  "frames",
                  "fps",
                  "x",
                  "y"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/definitions/petFile"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 96
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "anchor": {
                    "enum": [
                      "shoulder"
                    ]
                  },
                  "x": {
                    "type": "integer",
                    "minimum": -96,
                    "maximum": 95
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -128,
                    "maximum": 127
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "frame"
                }
              }
            },
            "then": {
              "required": [
                "window",
                "nameColor",
                "effect"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "window"
                    ]
                  },
                  {
                    "required": [
                      "nameColor"
                    ]
                  },
                  {
                    "required": [
                      "effect"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "frame",
                    "background",
                    "mountSkin"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "art"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "art"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "aura"
                }
              }
            },
            "then": {
              "required": [
                "aura"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "aura"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "trail"
                }
              }
            },
            "then": {
              "required": [
                "trail"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "trail"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "pet"
                }
              }
            },
            "then": {
              "required": [
                "pet"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "pet"
                ]
              }
            }
          }
        ]
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead",
        "rules"
      ],
      "properties": {
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "petFile": {
      "description": "Arkusz chowańca w src/client/art/pets.",
      "type": "string",
      "pattern": "^art/pets/[a-z0-9-]+\\.png$"
    },
    "petPlace": {
      "description": "Miejsce klatki chowańca w scenie Walki przy pudełku postaci (klatce jej chodu, figurze Systemu albo jeźdźcu z wierzchowcem): x pikseli od przodu (edge front, po prawej) albo tyłu pudełka (edge back) do lewego brzegu klatki, w prawo; dół klatki bottom pikseli nad dołem pudełka albo góra klatki top pikseli pod jego górą; behind: chowaniec za postacią.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "x"
      ],
      "properties": {
        "edge": {
          "enum": [
            "front",
            "back"
          ]
        },
        "x": {
          "type": "integer"
        },
        "bottom": {
          "type": "integer"
        },
        "top": {
          "type": "integer"
        },
        "behind": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "bottom"
          ]
        },
        {
          "required": [
            "top"
          ]
        }
      ]
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
