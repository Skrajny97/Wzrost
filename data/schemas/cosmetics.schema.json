{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sklep Systemu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "texts"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "price",
          "art"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "description": "frame: ramka portretu, background: tło portretu, mountSkin: wygląd wierzchowca ze Stajni.",
            "enum": [
              "frame",
              "background",
              "mountSkin"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "price": {
            "description": "Cena w Punktach Systemu.",
            "type": "integer",
            "minimum": 1
          },
          "art": {
            "description": "Obrazek bez .png: ramki i tła w src/client/art/cosmetics, wygląd wierzchowca w src/client/art/mounts.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "window": {
            "description": "Przezroczyste okno ramki w obrazku 120 × 160: [lewo, góra, prawo, dół] włącznie.",
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "nameColor": {
            "description": "Kolor imienia postaci w tej ramce.",
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "shine",
                  "pulse",
                  "fireflies"
                ]
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/point"
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "frame"
            }
          }
        },
        "then": {
          "required": [
            "window",
            "nameColor",
            "effect"
          ]
        },
        "else": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "window"
                ]
              },
              {
                "required": [
                  "nameColor"
                ]
              },
              {
                "required": [
                  "effect"
                ]
              }
            ]
          }
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead",
        "rules"
      ],
      "properties": {
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
