{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Klasy",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "short", "role", "start", "description", "position", "baseStats", "growth", "perClassLevel", "autoPoints", "recovery", "weapons", "offhands", "armor"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "name": { "type": "string", "minLength": 1 },
      "short": { "type": "string", "minLength": 1, "maxLength": 4, "description": "Skrót nazwy na górnym pasku, przy poziomie klasy (np. Woj)." },
      "role": { "type": "string", "minLength": 1 },
      "start": { "enum": ["gentle", "normal", "hard"], "description": "Jak łatwy jest start: łagodniejszy, zwykły albo trudniejszy. Ekran wyboru klasy to pokazuje." },
      "description": { "type": "string", "minLength": 1 },
      "position": { "enum": ["front", "middle", "back"] },
      "baseStats": { "$ref": "#/definitions/statMap" },
      "growth": { "$ref": "#/definitions/statMap" },
      "perClassLevel": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hp", "mana"],
        "description": "Maks. HP i maks. mana za każdy poziom klasy, poza tym, co dają statystyki.",
        "properties": {
          "hp": { "type": "number", "minimum": 0 },
          "mana": { "type": "number", "minimum": 0 }
        }
      },
      "autoPoints": { "$ref": "#/definitions/statMap" },
      "recovery": {
        "type": "object",
        "additionalProperties": false,
        "required": ["base", "perWisdom"],
        "properties": {
          "base": { "type": "number", "minimum": 0, "maximum": 1 },
          "perWisdom": { "type": "number", "minimum": 0, "maximum": 0.05 }
        }
      },
      "weapons": {
        "description": "Bazy broni klasy. Dopóki postać nie ma broni, łup w slocie broni jest jedną z nich.",
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "offhands": {
        "description": "Bazy drugiej ręki, których klasa może używać.",
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "armor": {
        "description": "Pancerze klasy: bazy hełmu i pancerza, które może nosić. Pancerz, którego nie wymienia żadna klasa (rękawice, buty), nosi każdy.",
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "definitions": {
    "statMap": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
  }
}
