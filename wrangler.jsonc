{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wzrost",
  "main": "src/server/index.js",
  "compatibility_date": "2026-10-19",
  // The game's own domain, registered in Cloudflare: the main address and
  // www. The workers.dev address stays as a spare one.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "insightrpg.com", "custom_domain": true },
    { "pattern": "www.insightrpg.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./src/client",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wzrost",
      // Placeholder for local dev and tests. The deploy workflow replaces it
      // with the real ID (tools/prepare-cloudflare.mjs).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Overridden on deploy with the short commit SHA.
    "APP_VERSION": "dev",
    // "on" while the game is being tested: the Walka tab gets "Pomiń czas",
    // which ends the current hunt or rest at once. "off" removes it.
    "TEST_MODE": "on",
    // The accounts that get test mode in the live game (comma-separated, any
    // case); empty gives it to everyone. Tests and `npm run dev` empty it.
    "TEST_LOGINS": "Skrajny",
    // The accounts that see the author's panel (comma-separated, any case),
    // once bound to Google (src/server/author.js). Empty: nobody.
    "AUTHOR_LOGINS": "Skrajny",
    // The addresses whose Google sign-in return address
    // (https://<address>/api/auth/google/callback) is registered in Google
    // Cloud Console; a sign-in started elsewhere moves to the first one.
    // The Google client id and secret are Worker secrets, set by the deploy
    // workflow from the GitHub secrets.
    "GOOGLE_HOSTS": "insightrpg.com,www.insightrpg.com",
    // "on" shows the professions (Profesje). They stay hidden in the live game
    // until all of the first three are ready; `npm run dev` and the test
    // version turn them on.
    "PROFESSIONS": "off"
  },
  // Cloudflare Email Service: the mail with the link that confirms an
  // account's e-mail (src/server/email.js), from the insightrpg.com domain
  // onboarded in the dashboard. Locally the mail is not sent, only shown in
  // the console.
  "send_email": [{ "name": "EMAIL" }],
  // Every minute the server sends the phone notifications whose time has
  // come (src/server/push.js).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // The test version at test.insightrpg.com: its own Worker and its own D1
    // database, deployed from the working branches (not main), so new parts of
    // the game can be tried on a phone before they reach the live game. The
    // database ID is filled in by the deploy workflow, as above.
    "test": {
      "name": "wzrost-test",
      "workers_dev": true,
      "routes": [{ "pattern": "test.insightrpg.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wzrost-test",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_VERSION": "dev",
        "TEST_MODE": "on",
        "TEST_LOGINS": "Skrajny",
        // No author's panel and no Google sign-in on the test version.
        "AUTHOR_LOGINS": "",
        "GOOGLE_HOSTS": "",
        "PROFESSIONS": "on",
        // No new accounts: only the author's, made before (the author's request).
        "REGISTRATION": "closed"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      // Bindings are not inherited: the test version sends the same mail.
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
