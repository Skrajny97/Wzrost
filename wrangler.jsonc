{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wzrost",
  "main": "src/server/index.js",
  "compatibility_date": "2026-10-19",
  // AsyncLocalStorage (node:async_hooks) and nothing more of Node's: each
  // request keeps its own language in it (src/server/i18n.js).
  "compatibility_flags": ["nodejs_als"],
  // The game's own domain, registered in Cloudflare: the main address and
  // www. The workers.dev address stays as a spare one.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "insightrpg.com", "custom_domain": true },
    { "pattern": "www.insightrpg.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./src/client",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wzrost",
      // Placeholder for local dev and tests. The deploy workflow replaces it
      // with the real ID (tools/prepare-cloudflare.mjs).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Overridden on deploy with the short commit SHA.
    "APP_VERSION": "dev",
    // "on" while the game is being tested: the Walka tab gets "Pomiń czas",
    // which ends the current hunt or rest at once. "off" removes it.
    "TEST_MODE": "on",
    // The accounts that get test mode in the live game (comma-separated, any
    // case); empty gives it to everyone. Tests and `npm run dev` empty it.
    "TEST_LOGINS": "Skrajny",
    // The accounts that see the author's panel (comma-separated, any case),
    // once bound to Google (src/server/author.js). Empty: nobody.
    "AUTHOR_LOGINS": "Skrajny",
    // The addresses whose Google sign-in return address
    // (https://<address>/api/auth/google/callback) is registered in Google
    // Cloud Console; a sign-in started elsewhere moves to the first one.
    // The Google client id and secret are Worker secrets, set by the deploy
    // workflow from the GitHub secrets.
    "GOOGLE_HOSTS": "insightrpg.com,www.insightrpg.com",
    // "on" shows the professions (Profesje): Zielarstwo and Alchemia are in
    // the live game from version 0.0.9.
    "PROFESSIONS": "on",
    // "on" opens Rzemieślnictwo among the professions; off, its square says
    // "Wkrótce". In the live game from version 0.0.27.
    "CRAFTING": "on",
    // "on": events at the end of an exploration (src/engine/events.js), in
    // the live game from version 0.0.43, without the outcomes the author has
    // not approved yet (drafts), which the test version has ("test").
    "EVENTS": "on",
    // "off" hides the class evolutions (src/server/evolutions.js): the
    // class grows past class level 50 as before them. Hidden in the live
    // game in versions 0.0.58–0.0.60, in it from version 0.0.61.
    "EVOLUTIONS": "on",
    // "on" opens the Osada (src/server/settlement.js) from character level
    // 20: parts I–III, in the live game from version 0.0.68 (the author:
    // "Wdrażaj 0.0.68 z Osadą"). Its auctions settle with the cron below.
    "SETTLEMENT": "on",
    // "on" lets a camp at its top turn into the Warownia
    // (src/server/fortress.js), with its seven buildings: in the live game
    // from version 0.1.49, once every building had its pictures (606, 608–610).
    "FORTRESS": "on",
    // "on" offers English beside Polish (src/server/i18n.js): the PL | EN
    // switch on the login screen and in the Ustawienia, and the answers in
    // the language chosen. In the live game from version 0.1.97 (the author:
    // "715 wszystko OK, wdrażaj angielski bez pytania"); the chat's
    // translations there need Workers AI, which the deploy adds
    // (tools/prepare-cloudflare.mjs).
    "ENGLISH": "on",
    // "on": the weeks of the year (data/weeks.json, src/server/weeks.js),
    // each with its small bonus for every player (the author, 10.11.2026);
    // "off" plays as before them.
    "WEEKS": "on",
    // "on": the Arena PvP in the Osada (src/server/pvp-arena.js, 762 A,
    // building 770.2 D) from character level 25. In the live game from
    // version 0.2.38, once the classes were evened out in its duels and the
    // weaker paths strengthened (772, 780 A; the author: "781 B").
    "ARENA": "on",
    // "on": the guild wars (src/server/guild-wars.js, 792–800): the Gildia's
    // Wojna tab, its teams and the battles every evening at 20:00 (the cron
    // below). In the live game from version 0.2.54, built on the accepted
    // mock-ups 792 v2; the first war is drawn on the Monday after.
    "GUILD_WARS": "on",
    // "on": the Labirynt Systemu and the Rdzeń with its Artefakty
    // (src/server/labyrinth.js, src/server/core.js; 850–866), the Labirynt
    // tab of the Sala prób from character level 30. In the live game from
    // version 0.2.87, once the author accepted the mock-ups 870.1–870.7.
    "LABYRINTH": "on",
    // "on": Talia Systemu, the Salon Gier's card game (src/server/cards.js;
    // 871–889): the Salon's Karty tab, the cards the creatures of an
    // exploration leave, the collection's bonus and the Encyklopedia's
    // Karty. In the live game from version 0.2.93, once the author accepted
    // the mock-ups 881, the cards' look 885–888 and the Encyklopedia's 889.
    "CARDS": "on",
    // The gateway of the payments for Punkty Systemu (src/server/payments.js,
    // src/server/payment-providers.js): "autopay" (805 D), or empty: off. Its
    // keys, AUTOPAY_SERVICE_ID and AUTOPAY_SHARED_KEY, are Worker secrets the
    // deploy workflow sets from the GitHub secrets; without them the
    // purchases stay off ("not found").
    "PAYMENTS": "autopay",
    // "authors": the purchases only for the author's accounts, while the
    // first real purchase is tried (the author, 11.11.2026: no test
    // environment); empty: for every player, once the purchase screen is
    // accepted and the terms name the seller and Autopay.
    "PAYMENTS_FOR": "authors",
    // Autopay's gateway: the real one in the game.
    "AUTOPAY_HOST": "https://pay.autopay.eu"
  },
  // Cloudflare Email Service: the mail with the link that confirms an
  // account's e-mail (src/server/email.js), from the insightrpg.com domain
  // onboarded in the dashboard. Locally the mail is not sent, only shown in
  // the console.
  "send_email": [{ "name": "EMAIL" }],
  // Every minute the server sends the phone notifications whose time has
  // come (src/server/push.js), and fights the guild wars' battles whose
  // evening has come (src/server/guild-wars.js).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    // The test version at test.insightrpg.com: its own Worker and its own D1
    // database, deployed from the working branches (not main), so new parts of
    // the game can be tried on a phone before they reach the live game. The
    // database ID is filled in by the deploy workflow, as above.
    "test": {
      "name": "wzrost-test",
      "workers_dev": true,
      "routes": [{ "pattern": "test.insightrpg.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wzrost-test",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_VERSION": "dev",
        "TEST_MODE": "on",
        "TEST_LOGINS": "Skrajny",
        // No author's panel and no Google sign-in on the test version.
        "AUTHOR_LOGINS": "",
        "GOOGLE_HOSTS": "",
        "PROFESSIONS": "on",
        "CRAFTING": "on",
        // No new accounts: only the author's, made before (the author's request).
        "REGISTRATION": "closed",
        // "Testuj samouczki" in the settings: every tutorial from its start.
        "TUTORIAL_TESTS": "on",
        // "test": the events with their drafts, and "Testuj zdarzenia" in the
        // settings (TUTORIAL_TESTS).
        "EVENTS": "test",
        // The class evolutions, with "Testuj ewolucję" (TUTORIAL_TESTS).
        "EVOLUTIONS": "on",
        // The Osada (src/server/settlement.js), only here until it is ready.
        "SETTLEMENT": "on",
        // The Warownia (src/server/fortress.js), as in the game.
        "FORTRESS": "on",
        // The English beta, only here (490–497 A).
        "ENGLISH": "on",
        // The weeks of the year, as in the game.
        "WEEKS": "on",
        // The Arena PvP in the Osada (src/server/pvp-arena.js, 762 A), as in
        // the game.
        "ARENA": "on",
        // The guild wars (src/server/guild-wars.js, 792–800), only here for
        // now, with "Test wojny" in the Wojna tab (TUTORIAL_TESTS).
        "GUILD_WARS": "on",
        // The Labirynt Systemu and the Rdzeń with its Artefakty, as in the
        // game (850–866).
        "LABYRINTH": "on",
        // Talia Systemu, the Salon Gier's card game, as in the game (871–889).
        "CARDS": "on",
        // The payments for Punkty Systemu: off until the Autopay test
        // account's keys are in the GitHub secrets (AUTOPAY_TEST_SERVICE_ID,
        // AUTOPAY_TEST_SHARED_KEY), then "autopay" with Autopay's test
        // gateway, where no money moves.
        "PAYMENTS": "",
        "AUTOPAY_HOST": "https://testpay.autopay.eu"
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      // Bindings are not inherited: the test version sends the same mail.
      "send_email": [{ "name": "EMAIL" }],
      // Workers AI, which translates chat messages ("A→ Przetłumacz",
      // src/server/chat-translate.js): only here, where English is on. It has
      // no local stand-in and always calls the Cloudflare account, so the
      // top level (tests, local work, the first steps in CI) goes without it.
      "ai": { "binding": "AI" }
    }
  }
}
