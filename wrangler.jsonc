{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wzrost",
  "main": "src/server/index.js",
  "compatibility_date": "2026-10-19",
  // The game's own domain, registered in Cloudflare: the main address and
  // www. The workers.dev address stays as a spare one.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "insightrpg.com", "custom_domain": true },
    { "pattern": "www.insightrpg.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./src/client",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wzrost",
      // Placeholder for local dev and tests. The deploy workflow replaces it
      // with the real ID (tools/prepare-cloudflare.mjs).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Overridden on deploy with the short commit SHA.
    "APP_VERSION": "dev",
    // "on" while the game is being tested: the Walka tab gets "Pomiń czas",
    // which ends the current hunt or rest at once. "off" removes it.
    "TEST_MODE": "on"
  },
  "observability": {
    "enabled": true
  }
}
